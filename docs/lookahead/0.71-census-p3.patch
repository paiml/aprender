+    // ---- #4709 P-3: a code ref counts as bound only when the graph resolves it ----
+
+    fn anchored(dir: &Path, name: &str, ty: &str, r: &str) {
+        std::fs::write(
+            dir.join(name),
+            format!("metadata:\n  version: 1.0.0\n  description: P-3 fixture\nentity:\n  type: {ty}\n  ref: {r}\n"),
+        )
+        .expect("fixture contract is writable");
+    }
+
+    fn graph(dir: &Path, rows: &[(&str, &str)]) {
+        let nt: String = rows
+            .iter()
+            .map(|(sym, v)| {
+                format!("<https://ont.paiml.dev/v1alpha1/symbol/{sym}> <https://ont.paiml.dev/v1alpha1/sym/resolved> \"{v}\"^^<http://www.w3.org/2001/XMLSchema#boolean> .\n")
+            })
+            .collect();
+        std::fs::write(dir.join("contracts.nt"), nt).expect("fixture graph is writable");
+    }
+
+    #[test]
+    fn a_code_ref_is_bound_only_when_the_graph_resolves_it() {
+        let tmp = tempfile::tempdir().expect("temp dir is creatable");
+        anchored(tmp.path(), "real.yaml", "code", "x::y::f");
+        anchored(tmp.path(), "ghost.yaml", "code", "no::such::symbol");
+        anchored(tmp.path(), "stale.yaml", "code", "x::y::gone");
+        graph(tmp.path(), &[("x::y::f", "true"), ("x::y::gone", "false")]);
+        let c = census_of(tmp.path()).expect("censuses");
+        assert_eq!(c.by_anchoring.instance, 1, "only the resolved ref is bound");
+        assert_eq!(c.by_anchoring.unanchored, 2);
+        assert_eq!(c.instance_unresolved.len(), 2);
+        assert!(c
+            .instance_unresolved
+            .iter()
+            .any(|p| p.ends_with("ghost.yaml")));
+        assert!(c
+            .instance_unresolved
+            .iter()
+            .any(|p| p.ends_with("stale.yaml")));
+        assert_eq!(c.by_entity_type.get("code"), Some(&1));
+        let a = c.by_anchoring;
+        assert_eq!(a.unanchored + a.class + a.instance, c.n_parsed);
+    }
+
