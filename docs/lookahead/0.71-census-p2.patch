+/// #4709 P-2: the `.yaml` files the shared walker leaves out because a directory on their path is named in
+/// `SKIPPED_DIRS`, by that name. The top-level `quarantine/` is `quarantined_n`'s and is not counted twice; a
+/// nested `quarantine/` is counted here, since `quarantined_n` never sees it. Counted, never parsed: the
+/// number says how much of the tree the census does not describe.
+fn skipped_by_name(root: &Path) -> BTreeMap<String, usize> {
+    let mut out = BTreeMap::new();
+    walk_skipped(root, root, &mut out);
+    out
+}
+
+fn walk_skipped(root: &Path, dir: &Path, out: &mut BTreeMap<String, usize>) {
+    let Ok(entries) = std::fs::read_dir(dir) else {
+        return;
+    };
+    for path in entries.flatten().map(|e| e.path()).filter(|p| p.is_dir()) {
+        let name = path.file_name().and_then(|n| n.to_str()).unwrap_or("");
+        if !SKIPPED_DIRS.contains(&name) {
+            walk_skipped(root, &path, out);
+        } else if path != root.join(QUARANTINE_DIR) {
+            let mut files = Vec::new();
+            collect_quarantined(&path, &mut files);
+            if !files.is_empty() {
+                *out.entry(name.to_string()).or_default() += files.len();
+            }
+        }
+    }
+}
