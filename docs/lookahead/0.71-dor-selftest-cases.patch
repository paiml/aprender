+# fixtures/dor/cases.json pins each fixture's exact verdict: the exit code and
+# RED line, or every row's missing fields in rank order and the ready count. An
+# exit code cannot tell one RED from another, so a rule change that alters any
+# single verdict fails here.
+CASES = HERE / "fixtures" / "dor" / "cases.json"
+UNITS = {"expand": expand, "absent_ids": absent_ids, "missing_fields": missing_fields}
+
+
+def load_cases():
+    return json.loads(CASES.read_text())
+
+
+def cli(*argv):
+    """(exit code, stdout) of main() on argv."""
+    saved, sys.argv = sys.argv, ["dor_check.py", *argv]
+    try:
+        with contextlib.redirect_stdout(io.StringIO()) as out:
+            rc = main()
+        return rc, out.getvalue()
+    finally:
+        sys.argv = saved
+
+
+def ledger_case(c, ref):
+    """(got, want) for a case that runs the CLI on a fixture ledger."""
+    ref, path = c.get("ref") or ref, HERE / "fixtures" / c["ledger"]
+    rc, out = cli(str(path), "--ref", ref, *(["--require-ready"] if c.get("require_ready") else []))
+    if c["expect"] == 2:
+        return (rc, out.strip()), (2, "RED: " + c["red"].replace("{ref}", ref))
+    try:
+        rows = [(rid, m) for _, rid, _, m in evaluate(yaml.safe_load(path.read_text()), ref)]
+    except Red as e:
+        rows = f"RED: {e}"
+    ready = re.search(r"top10_ready: (\d+/\d+)", out)
+    return (rc, rows, ready and ready[1]), (c["expect"], list(c["rows"].items()), c["ready"])
+
+
+def unit_case(u):
+    """(got, want) for a case that calls one rule directly."""
+    try:
+        got = UNITS[u["fn"]](*u["args"])
+    except Red:
+        got = "RED"
+    return got, u["want"]
+
+
+def expect_cases(ref):
+    cases = load_cases()
+    named = {c["ledger"] for c in cases if "ledger" in c}
+    failures = [f"fixture dor/{p.name} is named by no case"
+                for p in sorted(CASES.parent.glob("*.yaml")) if f"dor/{p.name}" not in named]
+    for c in cases:
+        got, want = unit_case(c) if "fn" in c else ledger_case(c, ref)
+        if got != want:
+            failures.append(f"case {c['id']}: got {got!r}, want {want!r}")
+    return failures if cases else ["the case table is empty"]
+
