+    #[test]
+    fn every_decodable_type_crosses_the_graph_as_itself() {
+        let mut seen = 0;
+        for code in 0..=64 {
+            if let Some(q) = WeightQuantType::from_ggml_type(code) {
+                assert_eq!(
+                    ggml_code(q),
+                    code,
+                    "{q:?} crossed the graph as another type"
