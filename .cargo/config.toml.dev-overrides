# Full-stack development overrides for aprender
#
# GH-344: Sibling repo path overrides are NOT in the committed Cargo.toml
# so that `git clone && cargo check` works standalone.
#
# To enable local sibling overrides, append this to your .cargo/config.toml:
#   cat .cargo/config.toml.dev-overrides >> .cargo/config.toml
#
# Or run: make dev-setup
#
# Required sibling repos (clone alongside aprender):
#   ../alimentar     — data loading (datasets feature)
#   ../batuta        — sovereign coding assistant (code feature in apr-cli)
#   ../realizar      — inference engine
#   ../whisper.apr   — whisper speech recognition (whisper feature in apr-cli)
#   ../entrenar      — training engine (includes entrenar-lora)
#   ../trueno        — SIMD compute (includes trueno-gpu, trueno-quant)
#   ../renacer       — profiling
#   ../pacha         — model registry
#
# NOTE: provable-contracts retired from this list 2026-05-04 per
# APR-MONO Phase 2b consolidation (2026-04-18). The crates moved
# in-tree as `aprender-contracts` + `aprender-contracts-macros`;
# Cargo.toml depends on the workspace crates directly, so no patch
# entry is needed.

[patch.crates-io]
alimentar = { path = "../alimentar" }
batuta = { path = "../batuta" }
realizar = { path = "../realizar" }
whisper-apr = { path = "../whisper.apr" }
entrenar = { path = "../entrenar" }
trueno = { path = "../trueno" }
trueno-gpu = { path = "../trueno/trueno-gpu" }
trueno-quant = { path = "../trueno/crates/trueno-quant" }
# provable-contracts-macros + provable-contracts retired 2026-05-04 per
# APR-MONO Phase 2b consolidation (2026-04-18). Now in-tree as
# aprender-contracts-macros + aprender-contracts; depended on as
# workspace members, no patch needed.
pacha = { path = "../pacha" }
entrenar-lora = { path = "../entrenar/crates/entrenar-lora" }
renacer = { path = "../renacer" }
