#!/usr/bin/env bash
# PATH shim for python, python3, uv and uvx (scripts/python_runcount.sh --run).
# Installed under each of those names in a shim dir that is put FIRST on PATH.
# It logs one record per call, then execs the real tool found later on PATH, so
# the real tool runs in this same pid: keys.awk joins the shim and the trace on it.
#   shim <TAB> pid <TAB> name
#   hash <TAB> pid <TAB> path <TAB> sha12   one per argument that is a regular file
# The hash is the sha256 of the file's first 64 KiB at call time: a temp script
# deleted before --count still keys by its content. No argument is parsed.
name="${0##*/}"
log="${PYRUN_LOG:-}"
self="${BASH_SOURCE[0]}"
if [ -n "$log" ]; then
    t=$'\t'
    here=$(pwd -P)
    pid=$$   # the real tool is exec'd below, so it runs in this pid
    rec="shim${t}${pid}${t}${name}"
    for a in "$@"; do
        case "$a" in *$'\n'*|*$'\t'*) continue ;; esac
        [ -f "$a" ] && [ -r "$a" ] || continue
        case "$a" in /*) p="$a" ;; *) p="$here/$a" ;; esac
        s=$(head -c 65536 -- "$a" | sha256sum) || continue
        rec="$rec"$'\n'"hash${t}${pid}${t}${p}${t}${s:0:12}"
    done
    printf '%s\n' "$rec" >> "$log"
fi
# The real tool: the first executable of this name on PATH that is not this shim. A
# nested --run puts a second shim dir on PATH; -ef skips every copy that links here,
# so a shim never execs a shim (one dir skipped by name looped for ever, #4754).
real=""
IFS=: read -r -a dirs <<< "$PATH"
for d in "${dirs[@]}"; do
    [ -n "$d" ] || continue
    [ -x "$d/$name" ] && [ ! -d "$d/$name" ] || continue
    [ "$d/$name" -ef "$self" ] && continue
    real="$d/$name"; break
done
if [ -z "$real" ]; then
    printf 'python_runcount shim: no real %s on PATH\n' "$name" >&2
    exit 127
fi
exec "$real" "$@"
