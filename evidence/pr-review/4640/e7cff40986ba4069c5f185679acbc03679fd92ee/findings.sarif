          "properties": {
            "grounding": "asserted",
            "rationale": "Carried forward: 88720eec64, b47e216668 and e7cff40986 change only the selftest block of scripts/cb200_head_vs_base.sh; the finding's subject is outside it. Not re-measured in this run, so it stays asserted.",
            "failure_scenario": "dogfood.sh on a main commit compares head against v0.69.3 (a release/0.69.3 cherry-pick line with 701 commits main lacks); a release branch that fixed definitions main never received makes main read RED, or one that added debt makes main read green, with no change on main's own lineage. Fix: select with git for-each-ref --merged HEAD (nearest ancestor tag) or document the cross-line comparison.",
            "precision_class": "advisory"
          }
        },
