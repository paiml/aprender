        {
          "ruleId": "ci-cleanup-set-e-abort",
          "level": "error",
          "message": {
            "text": "CONFIRMED by primary. GitHub Actions default `run:` shell is `bash --noprofile --norc -eo pipefail {0}` (-e active). The new step 'Release this run's target dir' (.github/workflows/ci.yml, added by this PR) runs `bash scripts/ci_run_target_release.sh ... ; rc=$?` with only `set -uo pipefail` of its own (no -e override, but -e is already active from the GHA invocation and this script's own `set` does not clear it). If ci_run_target_release.sh exits non-zero, the shell aborts at that line and `rc=$?` on the next line never executes, failing the whole step -- directly contradicting the step's own comment 'A cleanup never fails the build.'"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/ci.yml"
                },
                "region": {
                  "startLine": 949
                }
              }
            }
          ],
          "properties": {
            "grounding": "measured",
            "command": [
              "sed",
              "-n",
              "944,949p",
              ".github/workflows/ci.yml"
            ],
            "exit_code": 0,
            "stdout_sha256": null,
            "excerpt": "          set -uo pipefail\n          dir=\"/mnt/nvme-raid0/targets/aprender-ci/${PR_OR_REF}/run-${GITHUB_RUN_ID}\"\n          before=$(du -sh \"$dir\" 2> /dev/null | cut -f1)\n          bash scripts/ci_run_target_release.sh release \"$dir\" \"${GITHUB_JOB}-s${SHARD}-a${GITHUB_RUN_ATTEMPT}\" -- \\\n            bash -c 'docker run --rm -v \"$(dirname \"$0\"):/p\" \"$IMAGE\" rm -rf -- \"/p/$(basename \"$0\")\"' \n          rc=$?",
            "excerpt_sha256": "e74880b08e46e526e3f0a92f9f7b768b7b1cd09da6236b78186c078f088b0262",
            "precision_class": "advisory",
            "corroborating_commands": [
