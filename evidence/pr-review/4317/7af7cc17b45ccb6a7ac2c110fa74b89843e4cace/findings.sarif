                "grep",
                "-n",
                "run:",
                ".github/workflows/ci.yml"
              ]
            ],
            "reverified_by_primary": true,
            "divergence_class": "agreed",
            "failure_scenario": "Any run where ci_run_target_release.sh's `docker run --rm ... rm -rf` returns non-zero (e.g. the docker daemon is momentarily unavailable, or the build-image container fails to start) now fails the whole workspace-test-shard job for a reason unrelated to the tests it ran, on every shard of every PR, contradicting the step's stated intent and turning a best-effort disk-reclaim into a source of CI flakiness."
          }
        },
