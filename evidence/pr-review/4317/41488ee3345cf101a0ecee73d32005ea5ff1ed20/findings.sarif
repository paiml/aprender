      "results": [
        {
          "ruleId": "lexical-guard-bypass-naming",
          "level": "note",
          "message": {
            "text": "check_leanchecker_scoped.sh's CMD_RE requires an immediate terminator after the literal \"leanchecker\" (quote/space/EOL/;/)/&/|). A wrapper binary or script named e.g. leanchecker_wrapper.sh invoked in command position would not match CMD_RE (the char after \"leanchecker\" is \"_\", not in the terminator set) and would run unscoped without tripping the guard. This is a naming-trick bypass of a lexical guard, not a defect this delta introduces (the same class of limit the duplication-scan script documents about itself); low likelihood, advisory only."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "scripts/check_leanchecker_scoped.sh"
                },
                "region": {
                  "startLine": 25
                }
              }
            }
          ],
          "properties": {
            "grounding": "cited",
            "source": "scripts/check_leanchecker_scoped.sh:25 (CMD_RE definition)",
            "excerpt": "CMD_RE='(^|[;&|(`]|[[:space:]])((exec|env|nice|lake[[:space:]]+env|timeout([[:space:]]+-[^[:space:]]+)*[[:space:]]+[0-9]+[smhd]?)[[:space:]]+)*(\"?[^[:space:]\"]*/)?leanchecker(\"|[[:space:]]|$|[;)&|])'",
            "excerpt_sha256": "392b4e3b902199ad69eeddc611012ee0dd0ecf8f5dcff35faab8933078076e50",
            "failure_scenario": "An agent or script renames the invocation to bypass review attention (e.g. a helper script literally named leanchecker_run.sh calling the real binary internally) and the guard reports clean while the memory/CPU cap is not actually applied.",
            "precision_class": "advisory"
          }
        }
