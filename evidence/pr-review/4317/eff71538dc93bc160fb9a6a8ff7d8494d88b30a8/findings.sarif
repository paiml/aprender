        }
      ],
      "results": [
        {
          "ruleId": "ont10-empty-array-set-u",
          "level": "warning",
          "message": {
            "text": "scripts/release/ont10_readiness.sh:69 — `python3 - ... \"${missing[@]}\" <<'PY'` bare-expands the `missing` array under `set -uo pipefail`. On the success path (all 6 gates pass), `missing` is empty. On bash <4.4 (e.g. macOS's stock /bin/bash 3.2.57, still what `#!/usr/bin/env bash` resolves to on a Mac with no newer bash earlier in PATH), a bare `\"${arr[@]}\"` expansion of an empty array raises 'unbound variable' under `set -u`, crashing the script on exactly the all-clear/READY path instead of printing STOP(PUBLISH...) and exiting 0. Reverified against the actual source (not agy's cited line 63, which is `${#missing[@]}` — the count form, unaffected by this bug in any bash version; the affected line is 69). Empirically confirmed NOT to fail on this host's bash 5.1.16 (Linux CI is unaffected); the failure mode is real only on bash <4.4."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "scripts/release/ont10_readiness.sh" },
                "region": { "startLine": 69 }
              }
            }
          ],
          "properties": {
            "grounding": "measured",
            "outcome": "confirmed-refined",
            "severity_assessed": "medium",
            "failure_scenario": "An operator or CI runner invokes `scripts/release/ont10_readiness.sh <version>` on a shell where `env bash` resolves to bash <4.4 (stock macOS /bin/bash 3.2.57 is the realistic case; this repo's fleet includes mbps per CLAUDE.md), the release is fully ready (all 6 `missing` checks pass, the important/common case), and the script aborts with 'unbound variable: missing[@]' instead of printing the STOP(PUBLISH...) line and exiting 0 — the operator sees a crash on the happy path of a publish-readiness gate.",
            "command": ["bash", "-c", "set -uo pipefail; missing=(); python3 -c 'import sys; print(sys.argv[1:])' \"${missing[@]}\""],
            "exit_code": 0,
            "note": "This exact command exits 0 on bash 5.1.16 (this host / Linux CI); the bug requires bash <4.4 to manifest, which was not available to execute directly in this sandbox — recorded as a grounded-but-platform-conditional finding rather than a directly-reproduced crash."
          }
        }
      ]
