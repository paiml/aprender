      "results": [
        {
          "ruleId": "agy_unrecalculated_session_kv_len",
          "level": "warning",
          "message": {
            "text": "After the fit check switches to Serial, max_seq_len is not recomputed and the batched-prefill reserve stays subtracted (mod.rs:814)."
          },
          "properties": {
            "grounding": "asserted",
            "rationale": "Raised by the antigravity reviewer, which marked it measured (a rustc test in its own tree); the primary did not re-run that test. The primary agrees with the direction and puts the recoverable amount at the 1 GiB score budget, not the 4.6 GB claimed.",
            "failure_scenario": "When a QK-norm model cannot fit the FP16 batched prefill in VRAM, session_kv_len initially clamps the context length to a floor of 2048 because it subtracts the 4.6GB batched reserve. serial_when_fp16_prefill_does_not_fit then switches the prefill path to Serial. However, max_seq_len is never recalculated for the Serial path (which does not need the 4.6GB reserve), and resident_estimate hardcodes the reserve unconditionally. As a result, the session is artificially limited to 2048 tokens and will time out or fall back to CPU on long chat turns, wasting ~4.6GB of available VRAM that could have supported ~14,000 additional tokens.",
            "precision_class": "advisory"
          }
        }
      ]
    }
  ]
