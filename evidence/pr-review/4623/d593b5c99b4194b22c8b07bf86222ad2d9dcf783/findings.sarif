      "results": [
        {
          "ruleId": "complexity_build_increase",
          "level": "note",
          "message": {
            "text": "build() in gguf/cuda/mod.rs rose from cyclomatic 6 / cognitive 11 (base 316dee2c) to cyclomatic 8 / cognitive 13 (head); it grew from 125 to 147 lines. Cyclomatic stays under the repo threshold of 10; the new fns for_session (1/0), session_kv_len (1/1), resident_estimate (5/4) are small."
          },
          "properties": {
            "grounding": "measured",
            "command": [
              "pmat",
              "analyze",
              "complexity",
              "--file",
              "h1/mod.rs",
              "--format",
