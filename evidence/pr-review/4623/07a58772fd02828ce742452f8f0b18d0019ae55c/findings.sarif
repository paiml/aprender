          },
          "properties": {
            "grounding": "asserted",
            "rationale": "Raised by the antigravity reviewer as cited (ci/sections.yml); not re-run by the primary, who reached the same conclusion from a git grep over every cargo test site (ci_no_job_runs_serve_cuda_lib_on_device_less_runner). The primary also records the manual all-features targets the reviewer did not name.",
            "failure_scenario": "If a future CI job runs cargo test --features cuda on a non-GPU runner it will turn red on this test; today none does, so the jobs stay green.",
