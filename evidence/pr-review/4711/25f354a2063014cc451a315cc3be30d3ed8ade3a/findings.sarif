{
  "$schema": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/errata01/os/schemas/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "pmat"
        }
      },
      "results": [
        {
          "ruleId": "complexity_delta",
          "level": "note",
          "message": {
            "text": "pmat analyze complexity over head and base copies of the 9 changed non-test .rs files under crates/. Three functions rise, all under 10: build_tool_calling_message 3->4 (cognitive 6->7), to_grammar 1->3 (0->5), extract_tool_parameters 3->5 (2->6). No function from the removed #4623/#4630 files appears: gguf/cuda/mod.rs build and serve run are now identical to base. Values equal the f2338256ee receipt for the same files."
          },
          "properties": {
            "grounding": "measured",
            "command": [
              "pmat",
              "analyze",
              "complexity",
              "--format",
              "json",
              "--path",
              "<head and base copies of the changed non-test .rs files>"
            ],
            "exit_code": 0,
            "stdout_sha256": "e4593818370d567fb10e89d39e4ca32da51d6289937a486ee0326bd6dd2a0431",
            "failure_scenario": "a later branch in extract_tool_parameters crosses cyclomatic 10",
            "precision_class": "advisory"
          }
        },
        {
          "ruleId": "tdg_delta",
          "level": "note",
          "message": {
            "text": "pmat analyze tdg over head and base copies. No file changes letter grade except chat_template_official.rs A -> A+ (94.5 -> 98.2). cuda_chat_backend.rs B- 71.12 -> 71.02, openai_handlers.rs A- 87.52 -> 86.55, grammar/tool.rs A 93.5 -> 91.0, gpu_completions_handler.rs A 91.2 -> 90.3, realize_handlers.rs A 91.48 -> 91.02."
          },
          "properties": {
            "grounding": "measured",
            "command": [
              "pmat",
              "analyze",
              "tdg",
              "--format",
              "json",
              "--path",
              "<head and base copies>"
            ],
            "exit_code": 0,
            "stdout_sha256": "4b91bd0fa5971cd6117b79314274ba502ed4255e8ead905eac32a25c3658ed8b",
            "failure_scenario": "a file crosses below grade B and the tdg gate flips",
            "precision_class": "advisory"
          }
        },
        {
          "ruleId": "satd_none_introduced",
          "level": "note",
          "message": {
            "text": "pmat analyze satd reports 0 violations on both the head copy (9 files) and the base copy."
          },
          "properties": {
            "grounding": "measured",
            "command": [
              "pmat",
              "analyze",
              "satd",
              "--format",
              "json",
              "--path",
              "<head copy>"
            ],
            "exit_code": 0,
            "stdout_sha256": "0f337997eb607f2a757f6c78182c5f1843f2dae49aa9a9dbe4fc8ddcbca088d5",
            "failure_scenario": "a TODO or FIXME marker lands unreported",
            "precision_class": "advisory"
          }
        },
        {
          "ruleId": "revert_leaves_no_kv_residue",
          "level": "note",
          "message": {
            "text": "b49a662e86 removes only the #4623/#4630 serve-KV fold. The nine non-doc source files it touched (chat_load_tokenizers.rs, serve/handler_gpu_completion.rs, serve/handlers_include_01.rs, serve/mod.rs, api/tests/mod.rs, cuda/gpu_profile.rs, gguf/cuda/mod.rs, gguf/cuda/resident.rs, gguf/cuda/session_kv.rs) are now byte-identical to the merge base: git diff --numstat base..head over them is empty. serve_kv_limit_k1.rs and PMAT-4636.yaml are gone. docs/roadmaps/roadmap.yaml differs from base by only the 21-line PMAT-4650 entry. The three evidence dirs it deletes (4623 x2, 4630 x1) belong to the other PRs."
          },
          "properties": {
            "grounding": "measured",
            "command": [
              "git",
              "diff",
              "--numstat",
              "89ef1b7e35",
              "25f354a206",
              "--",
              "<the 9 KV-fold source files>"
            ],
            "exit_code": 0,
            "stdout_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
            "failure_scenario": "a KV-fold hunk survives the revert and ships under #4711 tools fix",
            "precision_class": "advisory"
          }
        },
        {
          "ruleId": "revert_leaves_no_dangling_symbol",
          "level": "note",
          "message": {
            "text": "git grep -w for serving_cuda_model, for_session, session_kv, serve_kv_limit_k1 and PMAT-4636 over crates, docs, contracts and scripts at head matches nothing (rc 1, empty), the same as at the base. fit_serving_context stays at 10 references on both, so the base D5 preflight is untouched."
          },
          "properties": {
            "grounding": "measured",
            "command": [
              "git",
              "grep",
              "-c",
              "-w",
              "-e",
              "serving_cuda_model",
              "-e",
              "for_session",
              "-e",
              "session_kv",
              "-e",
              "serve_kv_limit_k1",
              "-e",
              "PMAT-4636",
              "25f354a206",
              "--",
              "crates",
              "docs",
              "contracts",
              "scripts"
            ],
            "exit_code": 1,
            "stdout_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
            "failure_scenario": "a reference to a removed fn or module breaks the build of aprender-serve or apr-cli",
            "precision_class": "advisory"
          }
        },
        {
          "ruleId": "own_files_unchanged_since_last_receipt",
          "level": "note",
          "message": {
            "text": "Every source and test file in the PR diff under crates/ (12 files) is byte-identical at 25f354a206 to f2338256ee, the last reviewed head. The revert and the main merge changed none of #4711 own code, so the earlier review of the tools/template fix, the Qwen XML parser and the extract-fn refactor still describes it."
          },
          "properties": {
            "grounding": "measured",
            "command": [
              "git",
              "diff",
              "--stat",
              "f2338256ee",
              "25f354a206",
              "--",
              "<the 12 crates files in the PR diff>"
            ],
            "exit_code": 0,
            "stdout_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
            "failure_scenario": "the revert silently altered the tools fix and the earlier review no longer applies",
            "precision_class": "advisory"
          }
        },
        {
          "ruleId": "revert_compiles_not_verified",
          "level": "note",
          "message": {
            "text": "No cargo build or test could run on this host, so that the revert compiles, and that the 4650 tests (including qwen35_undeclared_xml_call_does_not_promote_inner_json_4650) are green at head, rest on reading and on the author logs. Reading shows call sites consistent: cuda_chat_backend.rs passes request.tools.as_deref() to tokenize_chat_prompt and to the realize_handlers variant, and no symbol of the removed files is referenced."
          },
          "properties": {
            "grounding": "asserted",
            "rationale": "host policy forbids cargo here; CI workspace-test is the compile check",
            "failure_scenario": "revert leaves a signature mismatch that only the compiler sees",
            "precision_class": "advisory"
          }
        }
      ]
    },
    {
      "tool": {
        "driver": {
          "name": "nvidia-cuda-docs"
        }
      },
      "invocations": [
        {
          "executionSuccessful": true,
          "toolExecutionNotifications": []
        }
      ],
      "results": []
    },
    {
      "tool": {
        "driver": {
          "name": "crux"
        }
      },
      "results": [
        {
          "ruleId": "crux_surface_covered",
          "level": "note",
          "message": {
            "text": "The diff changes the /v1/chat/completions request (tools reach the template) and response (message.tool_calls). contracts/crux-C-11-v1.yaml and contracts/crux-C-03-v1.yaml are present at head. gap_effect none."
          },
          "properties": {
            "grounding": "measured",
            "command": [
              "ls",
              "contracts/crux-C-11-v1.yaml",
              "contracts/crux-C-03-v1.yaml"
            ],
            "exit_code": 0,
            "stdout_sha256": "89602ee4d43dbf2334a2da7a2254260d0c94cdd4ae913d4f1f8626c6a902322f",
            "failure_scenario": "a surface with no covering contract would be crux_coverage none",
            "precision_class": "advisory"
          }
        }
      ]
    },
    {
      "tool": {
        "driver": {
          "name": "cargo-mutants"
        }
      },
      "invocations": [
        {
          "executionSuccessful": true,
          "toolExecutionNotifications": [
            {
              "level": "note",
              "message": {
                "text": "NOT re-run here: host policy runs cargo on another host only. The figures are the GPU-host run recorded at f2338256ee (18 in-diff mutants, 11 caught, 7 missed) and the 12 crates files are byte-identical to that head. The #4623/#4630 mutants of the old diff no longer exist. grammar/tool.rs, chat_template_official.rs and mod_create_demo.rs are include!d and were never enumerated."
              }
            }
          ]
        }
      ],
      "results": [
        {
          "ruleId": "mutants_survivors_carried",
          "level": "warning",
          "message": {
            "text": "7 survivors carried from f2338256ee, none re-run: try_gpu_backend and try_cached_backend replacements in openai_handlers.rs (1067, 1185), delete ! in format_chat_messages_official_thinking_tools (realize_handlers.rs 275), two replacements of format_chat_messages_for_state_thinking (323). Rust mutation is advisory under the skill."
          },
          "properties": {
            "grounding": "asserted",
            "rationale": "carried from an earlier receipt over byte-identical files; not measured by this run",
            "failure_scenario": "a surviving mutant in the tools-to-template path is a regression no test would catch",
            "precision_class": "advisory"
          }
        }
      ]
    },
    {
      "tool": {
        "driver": {
          "name": "antigravity"
        }
      },
      "invocations": [
        {
          "executionSuccessful": false,
          "toolExecutionNotifications": [
            {
              "level": "error",
              "message": {
                "text": "Consultation could not be performed. The disposable review tree step, git archive 25f354a2063014cc451a315cc3be30d3ed8ade3a | tar -x, was refused by the lane hook subagent-lock.sh (a lane runs read-only git only). agy itself resolves and runs (agy --version = 1.2.17); no review was attempted and the hook was not routed around. Verdict DEGRADED."
              },
              "properties": {
                "grounding": "measured",
                "command": [
                  "agy",
                  "--version"
                ],
                "exit_code": 0,
                "stdout_sha256": "def65f6e126b8289916c66a36d8532fe268897e174531b44e2b3fb1b0022865b"
              }
            }
          ]
        }
      ],
      "results": []
    }
  ]
