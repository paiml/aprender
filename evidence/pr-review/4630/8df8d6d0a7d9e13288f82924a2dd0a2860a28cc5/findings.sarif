        }
      ],
      "results": [
        {
          "ruleId": "crux.surface-covered",
          "level": "note",
          "message": {
            "text": "Surfaces: apr serve --context-length (KV sizing) and the HTTP error status on /v1/completions, /v1/chat/completions and streaming (500 -> 400 context exceeds N). Category C, Serving and Chat UX. contracts/crux-C-07-v1.yaml (vllm paged-attention KV) and contracts/crux-C-32-v1.yaml (vllm chunked prefill; a prompt longer than max_model_len returns 4xx; status draft) cover them. gap_effect none; no comparative claim is made by this diff."
          },
          "properties": {
            "grounding": "asserted",
            "rationale": "Contracts read; no crux gap is opened or closed by this PR and no claim against vllm is measured.",
            "failure_scenario": "If C-32 (draft) is later promoted while D5 keeps ignoring max_tokens, the contract would state a 4xx guarantee the batch path breaks (see PRREV-K1-MAXTOKENS-500).",
            "precision_class": "advisory"
          }
        }
      ]
    },
    {
      "tool": {
        "driver": {
          "name": "cargo-mutants",
          "informationUri": "https://github.com/paiml/aprender",
