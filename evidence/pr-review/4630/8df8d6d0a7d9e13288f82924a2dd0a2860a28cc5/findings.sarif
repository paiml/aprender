    {
      "tool": {
        "driver": {
          "name": "antigravity",
          "informationUri": "https://github.com/paiml/aprender",
          "rules": []
        }
      },
      "invocations": [
        {
          "executionSuccessful": true,
          "commandLine": "agy -p <prompt file> --output-format json --json-schema .pr-review-schema.json --model gemini-3.1-pro-high --print-timeout 30m --dangerously-skip-permissions --add-dir <disposable tree>"
        }
      ],
      "results": [
        {
          "ruleId": "antigravity.gpu_batch_completions_missing_preflight",
          "level": "note",
          "message": {
            "text": "agy: /v1/batch/completions (gpu_batch_completions_handler) has no serve_context_refusal pre-flight. Primary assessment: the claim is true as a fact but its scenario is wrong for this route. That handler runs cached_model.batch_generate_gpu, not the CUDA serving model whose KV K1 sizes, so cached_serving_context does not define its limit; its GPU-batch error arm is a literal 500 (batch_processing.rs, pre-existing, the PR touches 2 lines of that file). agy cites docs/audits/quorum-PMAT-4616.json, which is committed by this PR and says the same sentence, so this is a repetition of a prior review, not an independent finding."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "crates/aprender-serve/src/api/batch_processing.rs"
                },
                "region": {
                  "startLine": 355
                }
              }
            }
          ],
          "properties": {
            "grounding": "cited",
            "source": "docs/audits/quorum-PMAT-4616.json",
            "excerpt": "`/v1/batch/completions` (gpu_batch_completions_handler) is not given a pre-flight `serve_context_refusal` check the way chat/completions/stream are, though the ticket's stated three surfaces (chat, completions, stream) are all covered and this handler's underl",
            "excerpt_sha256": "b3878064beb8801f1804a470fac16d73cc2b23ca342c5ce6c8b7b29f0f01454f",
            "failure_scenario": "A batch of prompts with one prompt over the serving context relies on the typed-error path through generate_gpu_resident rather than a pre-flight; a regression to a raw GPU fault would silently return 500 with no test catching it.",
            "precision_class": "advisory",
            "reverified_by_primary": false,
            "divergence": "contradicted"
          }
        },
        {
          "ruleId": "antigravity.try_cuda_generate_missing_preflight",
          "level": "note",
          "message": {
            "text": "agy: try_cuda_generate (/v1/generate) lacks the serve_context_refusal pre-flight. Primary assessment: true as a fact; not a defect today, because generate_gpu_resident raises ContextLimitExceeded (check_gpu_resident_preconditions, generate_2.rs:479) and this handler maps it through generation_error_status to 400. Only a regression of that typed path would 500."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "crates/aprender-serve/src/api/batch_processing.rs"
                },
                "region": {
                  "startLine": 456
                }
              }
            }
          ],
          "properties": {
            "grounding": "asserted",
            "rationale": "agy asserted without a citation.",
            "failure_scenario": "Requests to /v1/generate with prompts over the serving context lose the immediate 400 if the downstream typed-error path regresses to a GPU fault, returning 500.",
            "precision_class": "advisory",
            "reverified_by_primary": false,
            "divergence": "agy_only"
          }
        },
        {
          "ruleId": "antigravity.logprobs_missing_preflight",
          "level": "note",
          "message": {
            "text": "agy: logprobs_handler and perplexity_handler lack the serve_context_refusal pre-flight. Primary assessment: true as a fact; the logprobs handler maps errors with generation_error_status (gpu_completions_handler.rs near line 710), so the typed path gives 400 today."
          },
          "locations": [
            {
              "physicalLocation": {
