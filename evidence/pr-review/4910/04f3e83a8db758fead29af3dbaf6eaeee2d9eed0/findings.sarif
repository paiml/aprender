        }
      },
      "invocations": [
        {
          "executionSuccessful": true,
          "toolExecutionNotifications": []
        }
      ],
      "results": [
        {
          "ruleId": "rp-unq-fails-on-spaces-and-comments",
          "level": "note",
          "message": {
            "text": "rp_unq quote stripping fails if the YAML value contains leading/trailing alignment spaces or inline comments, because release_policy_block.awk preserves them."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "scripts/lib/release_policy.sh"
                },
                "region": {
                  "startLine": 74
                }
              }
            }
          ],
          "properties": {
            "grounding": "measured",
            "command": [
              "bash",
              "-c",
              "cat > test_ladder_spaces.yaml <<'EOF'\\n  release_policy:\\n    name: crux-smoke\\n    since: \"0.0.0\"\\n    date: \"2026-10-07\"\\n    quote: \"q\"\\n    hosts: [lambda, gx10]\\n    thinking: [\"off\", \"on\"]\\n    larger_rows: nightly\\n    red_row_needs: ticket\\n    ticket_owner: '#123' # comment\\n    release_notes: known_failures\\nEOF\\nsource scripts/lib/release_policy.sh\\nrp_ticket_owner test_ladder_spaces.yaml\\necho \"RC=$? WHY=$RP_WHY\""
            ],
            "source": "scripts/lib/release_policy.sh",
            "failure_scenario": "A maintainer adds an inline comment (e.g., `ticket_owner: '#42' # comment`) or uses multiple spaces for alignment (`since:   '0.71.0'`). Because `release_policy_block.awk` preserves these spaces and comments, the extracted string does not start or end with a quote character. `rp_unq`'s strict anchor regexes (`^\"(.*)\"$`) then fail to strip the quotes. The subsequent validations fail, and the nightly job either fails closed with no tickets opened, or the release policy is erroneously rejected.",
            "precision_class": "advisory",
            "rationale_for_class": "The antigravity arm is advisory until it has 30 measured samples; the primary reproduced the comment case on the reviewed head (rc 2, fails closed)."
          }
        },
        {
          "ruleId": "has-entry-awk-fails-on-leading-spaces",
          "level": "warning",
          "message": {
            "text": "release_policy_has_entry.awk fails to parse version strings with multiple leading alignment spaces due to single-space consumption in the regex."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "scripts/lib/release_policy_has_entry.awk"
                },
                "region": {
                  "startLine": 10
                }
              }
            }
          ],
          "properties": {
            "grounding": "measured",
            "command": [
              "bash",
              "-c",
              "cat > test_has_entry_spaces.yaml <<'EOF'\\n  emergency_scopes:\\n    - name: test\\n      release:   '1.2.3'\\nEOF\\nawk -v v=\"1.2.3\" -f scripts/lib/release_policy_has_entry.awk test_has_entry_spaces.yaml\\necho \"RC=$?\""
            ],
            "source": "scripts/lib/release_policy_has_entry.awk",
            "failure_scenario": "If an emergency scope entry is formatted with multiple alignment spaces (e.g., `- release:   \"1.2.3\"`), the regex `/^    (- |  )release:[ ]/` consumes exactly one space. The extra spaces are retained in the extracted string `r` (e.g., `  \"1.2.3\"`). The subsequent quote stripping condition `r ~ /^\".*\"$/` fails because the string starts with a space. The version match fails, and the script falsely reports no entry, allowing a duplicate entry to be appended which violates the one-ruling-per-release rule.",
            "precision_class": "advisory",
            "rationale_for_class": "Advisory until the arm has 30 measured samples; the primary reproduced it on the real awk (rc 1, expected 0)."
          }
        },
        {
          "ruleId": "known-failures-ticket-truncated-at-blank",
          "level": "note",
          "message": {
            "text": "rp_known_failures incorrectly truncates ticket values containing spaces inside quotes (due to t = $2), preventing the new quote stripping logic from matching."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "scripts/lib/release_policy.sh"
                },
                "region": {
                  "startLine": 136
                }
              }
            }
          ],
          "properties": {
            "grounding": "measured",
            "command": [
              "bash",
              "-c",
              "cat > test_kf_space.yaml <<'EOF'\\n  known_red:\\n    - rung: test-rung\\n      ticket: \"#42 \"\\nEOF\\nsource scripts/lib/release_policy.sh\\nrp_known_failures test_kf_space.yaml repo"
            ],
            "source": "scripts/lib/release_policy.sh",
            "failure_scenario": "A maintainer accidentally includes a trailing space inside the quotes of a ticket (e.g., `ticket: \"#123 \"`). The awk script uses `t = $2`, which truncates the string at the space (yielding `\"#123`). The new quote stripping logic `t ~ /^\".*\"$/` fails to match because the truncated string no longer ends with a quote. The leading quote is retained and incorrectly emitted, resulting in malformed release notes like `known red (ladder), \"#123`.",
            "precision_class": "advisory",
            "rationale_for_class": "Advisory until the arm has 30 measured samples; the primary reproduced it (the release note prints the leading quote)."
          }
        }
      ]
    }
  ]
}
