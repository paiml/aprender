            ],
            "source": "scripts/lib/release_policy.sh",
            "failure_scenario": "If a user writes `ticket_owner: '#123'` to avoid YAML treating `#` as a comment, `rp_ticket_owner` strips only double quotes. The remaining single quotes cause the validation regex to fail, preventing nightly scripts from filing tickets or erroneously blocking the release with an invalid owner error.",
            "precision_class": "advisory",
