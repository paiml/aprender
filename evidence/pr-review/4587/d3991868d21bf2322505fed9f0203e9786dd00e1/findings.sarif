            ],
            "exit_code": 0,
            "stdout_sha256": "053f06ffad15e8b029ca828ca15c53a9e271d4531963519b9b499ed19c0efeb1",
            "failure_scenario": "A self-test that passes proves the guard turns RED on the planted cases only, not that the gate is wired into the branch-protection set.",
            "precision_class": "advisory"
          }
        },
        {
