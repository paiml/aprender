{
  "$schema": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/errata01/os/schemas/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "pmat",
          "informationUri": "https://github.com/paiml/paiml-mcp-agent-toolkit",
          "rules": []
        }
      },
      "invocations": [
        {
          "executionSuccessful": true,
          "commandLine": "pmat query \"fat secret pass-through validation ci.yml sections.yml\" --limit 10",
          "exitCode": 0,
          "properties": {
            "index_commit": "97f0982a171f3dc15258afbdb7ac8dfbfc10c2dc",
            "index_is_ancestor": true,
            "index_worktree_dirty": false,
            "transport": "cli",
            "note": "index was rebuilt this invocation (shared .pmat/context.db on this host was concurrently written by other sessions, invalidating the on-disk manifest); load_index=212930ms, query=894ms, docs=9576ms."
          }
        }
      ],
      "results": [
        {
          "ruleId": "pmat-semantic-duplication",
          "level": "note",
          "message": {
            "text": "No pre-existing script matches scripts/check_fat_secrets_passed.sh's purpose (secret pass-through validation between ci.yml and ci/sections.yml). pmat's semantic index returned only unrelated Rust hits (e.g. crates/aprender-core/src/transfer/mod.rs); a direct grep for FAT_SECRET_ usage across scripts/*.sh matches only the new file itself."
          },
          "properties": {
            "grounding": "measured",
            "command": [
              "pmat",
              "query",
              "fat secret pass-through validation ci.yml sections.yml",
              "--limit",
              "10"
            ],
            "exit_code": 0,
            "stdout_sha256": "1080d92d1b077653677feac2da5872dca7bdc6b837dab137587ca5151b3bc327",
            "corroborating_command": [
              "find",
              ".",
              "-name",
              "*.sh",
              "-exec",
              "grep",
              "-l",
              "FAT_SECRET_",
              "{}",
              ";"
            ],
            "corroborating_exit_code": 0,
            "corroborating_stdout_sha256": "70121338be95951f4ba8b20accccfd39537d6a148bfff2cb57b89d2334f2ddc8",
            "failure_scenario": "n/a \u2014 informational; no duplication finding to act on.",
            "precision_class": "advisory"
          }
        }
      ]
    },
    {
      "tool": {
        "driver": {
          "name": "antigravity",
          "informationUri": "https://github.com/paiml/agy",
          "rules": []
        }
      },
      "invocations": [
        {
          "executionSuccessful": true,
          "commandLine": "agy --model gemini-3.1-pro-high --output-format json --json-schema agy-review-v1.schema.json --dangerously-skip-permissions",
          "exitCode": 0,
          "properties": {
            "model": "gemini-3.1-pro-high",
            "model_family": "google/gemini",
            "reviewer_model": "claude-sonnet-5",
            "same_family": false,
            "status_field_used_for_validation": false,
            "validated_by": [
              "structured_output.reviewed == true",
              "check-jsonschema against agy-review-v1.schema.json"
            ],
            "duration_seconds": 203.362224815,
            "usage": {
              "input_tokens": 109283,
              "output_tokens": 22946,
              "thinking_tokens": 19782,
              "cache_read_tokens": 754230,
              "total_tokens": 132229
            },
            "dispatch_tree": "rsync copy (no .git), diff/prompt/schema passed as files, not inline"
          }
        }
      ],
      "results": [
        {
          "ruleId": "bug-s1-regex-strictness",
          "level": "warning",
          "message": {
            "text": "S1's grep anchors the FAT_SECRET_<NAME> line with a trailing `[[:space:]]*$`, so a line with a trailing inline comment (e.g. `FAT_SECRET_X: ${{ secrets.X }}  # note`) is reported as NOT passed even though the pass-through is correct."
          },
          "properties": {
            "grounding": "measured",
            "command": [
              "bash",
              "scripts/check_fat_secrets_passed.sh",
              "<repro1/sections.yml>",
              "<repro1/ci.yml>"
            ],
            "exit_code": 1,
            "stdout_sha256": "3e45a02178466b2eb6fd1f4ab601f49787b7afd49d96e161751ac57ab45ccec0",
            "location": {
              "file": "scripts/check_fat_secrets_passed.sh",
              "line": 27
            },
            "failure_scenario": "A future contributor adds a trailing `# why` comment on a correct FAT_SECRET_ line in ci.yml; CI goes red on a correct pass-through, and the fix (deleting a helpful comment) is not obvious from the error.",
            "precision_class": "advisory",
            "classification": "agy_only",
            "consultation_note": "Found by the antigravity (gemini-3.1-pro-high) cross-vendor review; not caught by my own initial read of the script. Reproduced and confirmed real."
          }
        },
        {
          "ruleId": "bug-s2-greedy-sed",
          "level": "warning",
          "message": {
            "text": "S2 extracts the mapped secret name with `sed -nE 's/.*secrets\\.([A-Za-z0-9_]+).*/\\1/p'` on the ci.yml line. The leading `.*` is greedy, so on a line with two `secrets.` mentions (e.g. a trailing comment repeating the name, or a different name), the LAST match wins instead of the first, silently checking the wrong name."
          },
          "properties": {
            "grounding": "measured",
            "command": [
              "bash",
              "scripts/check_fat_secrets_passed.sh",
              "<repro2/sections.yml>",
              "<repro2/ci.yml>"
            ],
            "exit_code": 1,
            "stdout_sha256": "327e37bf2f5cd0bf7d6ee858c750ff98b958c34b7cf96fb0103088c186d36f2b",
            "location": {
              "file": "scripts/check_fat_secrets_passed.sh",
              "line": 34
            },
            "failure_scenario": "A FAT_SECRET_X line whose comment happens to mention a second secrets.Y name causes S2 to validate Y instead of X, masking a real X/name mismatch.",
            "precision_class": "advisory",
            "classification": "agy_only",
            "consultation_note": "Found by the antigravity cross-vendor review. Reproduced and confirmed real; same root cause class as the S1 finding (both anchor on comment-free lines)."
          }
        },
        {
          "ruleId": "gap-case-table-empty-val",
          "level": "note",
          "message": {
            "text": "The --self-test case table (6 rows) has no row for a FAT_SECRET_<NAME> line with no `secrets.` reference at all. The script's current behavior on that input is correct (rejects it), but nothing in the case table exercises that path."
          },
          "properties": {
            "grounding": "measured",
            "command": [
              "bash",
              "scripts/check_fat_secrets_passed.sh",
              "<repro3/sections.yml>",
              "<repro3/ci.yml>"
            ],
            "exit_code": 1,
            "stdout_sha256": "bd59762b250a446cc7f9ea29ce64ac1443490eeb1a1a7cbfc44dd85be1fc1de5",
            "failure_scenario": "A future edit to S2's sed regex regresses this path silently, because no case-table row would catch it.",
            "precision_class": "advisory",
            "classification": "agy_only",
            "consultation_note": "Found by the antigravity cross-vendor review. Reproduced: current behavior is correct, so this is a test-coverage gap, not a behavior bug."
          }
        },
        {
          "ruleId": "gap-case-table-unused-secret",
          "level": "note",
          "message": {
            "text": "The case table does not test a FAT_SECRET_<NAME> that is correctly mapped in ci.yml but unused by ci/sections.yml (an orphaned secret pass-through)."
          },
          "properties": {
            "grounding": "asserted",
            "rationale": "Not independently reproduced with a command this run; accepted on read of the case table (scripts/check_fat_secrets_passed.sh --self-test) against S1/S2's logic, which indeed has no row shaped this way. Low-priority design-scope note: S1/S2 as written check 'every section secret is passed', not the inverse 'every passed secret is used', so this is likely out of scope rather than a gap.",
            "failure_scenario": "An unused FAT_SECRET_ line lingers after its consumer is deleted, with no guard ever flagging the dead pass-through.",
            "precision_class": "advisory",
            "classification": "agy_only"
          }
        },
        {
          "ruleId": "unchecked-secret-github-token",
          "level": "none",
          "message": {
            "text": "SUPPRESSED BY MEASUREMENT (skill \u00a71.2). agy's original claim: GITHUB_TOKEN appears in both files but is explicitly skipped and not validated by the script. Measured: GITHUB_TOKEN is served through a wholly separate, intentional mechanism (direct job-level `GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}` env in ci.yml, read by scripts/ci/fat_driver.py via `os.environ.get(\"GITHUB_TOKEN\", \"\")`, never through FAT_SECRET_ indirection), so the script's explicit skip of GITHUB_TOKEN is correct-by-design, not a gap."
          },
          "properties": {
            "grounding": "measured",
            "command": [
              "grep",
              "-n",
              "GITHUB_TOKEN",
              "scripts/ci/fat_driver.py"
            ],
            "exit_code": 0,
            "stdout_sha256": "cb95de9bd26fe3f0846ae456c60cc9d58258c1355717e51ea53e7ce895459a56",
            "failure_scenario": "n/a \u2014 finding contradicted by measurement, dropped from primary findings.",
            "precision_class": "advisory",
            "classification": "contradicted",
            "suppressed_by_measurement": true
          }
        }
      ]
    }
  ]
}
