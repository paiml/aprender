      "tool": {
        "driver": {
          "name": "antigravity",
          "version": "1.1.24",
          "rules": [
            {
              "id": "PRREV-AGY",
              "name": "cross-vendor review (advisory)"
            },
            {
              "id": "PRREV-AGY-PRIOR",
              "name": "cross-vendor finding on an earlier commit of this PR, absent on the head"
            }
          ]
        }
      },
      "invocations": [
        {
          "executionSuccessful": true,
          "toolExecutionNotifications": []
        }
      ],
      "results": [
        {
          "ruleId": "PRREV-AGY",
          "level": "warning",
          "message": {
            "text": "Manual edit of generated scripts/ci.sh drops property tests for 7 workspace crates"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "scripts/ci.sh"
                },
                "region": {
                  "startLine": 41
                }
              }
            }
          ],
          "properties": {
            "grounding": "measured",
            "precision_class": "advisory",
            "failure_scenario": "The author manually edited `scripts/ci.sh` (which explicitly warns `Generated by bashrs - DO NOT EDIT MANUALLY`) instead of its source `scripts/ci.rs`. The manual edit restricts property tests to `-p aprender-core`, dropping the `property_tests` targets for 7 other crates in the workspace (including `aprender-db` and `aprender-graph`). Regressions in those crates will silently pass CI, and this manual change will be overwritten the next time `bashrs` runs.",
            "source": "agy gemini-3.1-pro-high: cargo test --workspace --test property_tests",
            "excerpt": "cargo test --workspace --test property_tests",
            "excerpt_sha256": "d5acccdb9bd33f0b8476350d24db18e86002218928e4b9f66551fd94dbba7e25",
            "disposition": "agreed and fixed in 436c15092: `cargo test --workspace --test property_tests` (8 targets, 151 tests listed); the header now says hand-maintained because scripts/ci.rs is not in the tree"
          }
        },
        {
          "ruleId": "PRREV-AGY",
          "level": "warning",
          "message": {
            "text": "The docstring for `_executor_side` is placed after executable statements, preventing it from being bound to `__doc__`"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "scripts/lib/parity_block.py"
                },
                "region": {
                  "startLine": 484
                }
              }
            }
          ],
          "properties": {
            "grounding": "measured",
            "precision_class": "advisory",
            "failure_scenario": "Python's `__doc__` mechanism requires the docstring to be the very first logical line in the function body. Because the string literal follows executable statements (`witnesses = witnesses or {}` and `meta_c = meta.get(\\\"concurrency\\\")`), it is evaluated as a regular string literal and discarded. The function will have no docstring in documentation generators or `help()`.",
            "source": "agy gemini-3.1-pro-high: python3 -c import scripts.lib.parity_block as pb; print(pb._executor_side.__doc__)",
            "excerpt": "python3 -c import scripts.lib.parity_block as pb; print(pb._executor_side.__doc__)",
            "excerpt_sha256": "6f2adb122a8f42c1ff3674ad66691d36830c5bc0704f35affa6fa7ee8e16fe54",
            "disposition": "agreed and fixed in 436c15092: the docstring is the first statement of _executor_side again (__doc__ is set)"
          }
        }
      ]
    }
  ]
}
