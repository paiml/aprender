          "properties": {
            "grounding": "asserted",
            "rationale": "agy (gemini-3.1-pro-high) finding `removed-alias-example`, agy mark `asserted`. Re-marked asserted: agy supplied no excerpt or stdout digest that could be verified. The primary did not re-verify it.",
            "failure_scenario": "Users reading the Quick Start guide will not learn about the user-friendly model alias feature (`apr pull qwen2.5-coder-1.5b`), as the clean example was removed and replaced entirely with an opaque cache path.",
            "precision_class": "advisory"
          }
        }
      ]
    }
  ]
