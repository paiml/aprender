          "level": "note",
          "message": {
            "text": "The bare run at head exits 0 with four ok runs: mutants-nightly.yml:89, ci/sections.yml:3478 (scope), ci/sections.yml:3987, ci.yml:652."
          },
          "properties": {
            "grounding": "measured",
            "command": [
              "bash",
              "scripts/check_mutants_memory_cap.sh"
            ],
            "exit_code": 0,
            "stdout_sha256": "f2c9b3795bfac857e42d2f2393ded2aab13ba4b6fd5047ce994601f603a3b95f",
            "failure_scenario": "If the cuda scope lost its flags the bare run would turn rc 1.",
