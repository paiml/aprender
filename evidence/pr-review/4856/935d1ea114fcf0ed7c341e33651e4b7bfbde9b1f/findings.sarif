      "results": [
        {
          "ruleId": "scope_end_double_quote_strip_in_limit",
          "level": "note",
          "message": {
            "text": "Round-3 diff (strip double-quoted spans before the single-quote count) read in full; no new gap within the guard stated limit (a tripwire against an accidental drop, not an author who hides a cap). Residual cases need deliberate construction: a backslash-escaped double quote, or a double-quoted string spanning lines, can still skew parity. The real cuda step balances on every line."
          },
          "properties": {
            "grounding": "cited",
            "source": "scripts/check_mutants_memory_cap.sh:45",
            "excerpt": "start && kind == \"scope\" { r = $0; gsub(/\"[^\"]*\"/, \"\", r); inq = (inq + gsub(\"\\047\", \"\", r)) % 2",
            "excerpt_sha256": "575312458fdc8dc7ec2c948cd782208f6e784587e8eec250a8342903582889bb",
            "failure_scenario": "An author who writes an escaped double quote on the scope line could skew the parity and reopen the round-1 hole; that is the hidden-cap case the guard states it does not defend.",
            "precision_class": "advisory"
          }
        },
        {
          "ruleId": "round2_apostrophe_fixed",
          "level": "note",
          "message": {
            "text": "Round-2 finding (apostrophe inside a double-quoted argument kept the scope open) is fixed: the echo repro with an apostrophe now gives rc 1 (FAIL native: no capped docker run or systemd-run scope), and row scopeapos pins it."
          },
          "properties": {
            "grounding": "measured",
            "command": [
              "bash",
              "scripts/check_mutants_memory_cap.sh",
              "<temp file: capped systemd-run echo with an apostrophe in double quotes, then bare mutants_diff_gate.sh>"
            ],
            "exit_code": 1,
            "stdout_sha256": "1e43eaf2e5407a157bcb79469941b430c920b3039f09b44a99fb5faf6fc3620c",
            "failure_scenario": "Without the double-quote strip the repro passes with rc 0.",
            "precision_class": "advisory"
          }
        },
        {
          "ruleId": "round1_findings_still_fixed",
          "level": "note",
          "message": {
            "text": "Round-1 findings stay fixed: scope-wraps-echo gives rc 1 (scopeother) and MemorySwapMax=8 gives rc 1 (scopeswnz). --self-test passes at head; the bare run judges the same four runs ok, the cuda scope at ci/sections.yml:3478 included."
          },
          "properties": {
            "grounding": "measured",
            "command": [
              "bash",
              "scripts/check_mutants_memory_cap.sh",
              "--self-test"
