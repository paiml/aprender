      "results": [
        {
          "ruleId": "agy-pipe-exit-status-verdict",
          "level": "note",
          "message": {
            "text": "Pipeline at end of script exits 1 on green runs due to pipefail, turning a GO verdict into a NO-GO script exit status."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "scripts/release/t2_preflight.sh"
                },
                "region": {
                  "startLine": 262
                }
              }
            }
          ],
          "properties": {
            "grounding": "measured",
            "failure_scenario": "The script ends with a pipeline `grep -E ... | cut -c1-160`. On a perfectly green log with no `[FAIL]` lines, `grep` exits 1. Because `set -uo pipefail` is active at the top of the script, the entire pipeline exits 1. As the last command executed, this causes `t2_preflight.sh` to exit with status 1. Callers (like `prepare_bump.sh`) will read this exit status as a failure (NO-GO) despite `decide()` correctly evaluating the log as GO.",
            "precision_class": "advisory",
            "command": [
              "bash",
              "-c",
              "cat << 'EOF' > test.sh\nset -uo pipefail\ntouch empty.log\ngrep -E '^\\s*\\[FAIL\\]' empty.log | cut -c1-160\nEOF\nbash test.sh; echo rc=$?"
            ],
            "measured_by": "agy",
            "note": "agy returned the command but no exit code or stdout digest; the primary re-ran the relevant command itself (see the pmat run)"
          }
        },
        {
          "ruleId": "agy-dogfood-gates-loosened",
          "level": "note",
          "message": {
            "text": "The dogfood-gates row is now conditionally deferred."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "scripts/release/t2_preflight.sh"
                },
                "region": {
                  "startLine": 86
                }
              }
            }
          ],
          "properties": {
            "grounding": "cited",
            "failure_scenario": "The `dogfood-gates` row is a roll-up of declared gate failures. In this patch, it is explicitly excused (`continue`) if its RED count equals the number of declared failing gates. Previously, any `[FAIL]` row (except `version-unpublished`) including `dogfood-gates` would increment the `fails` counter and cause a NO-GO. Now, it is loosely evaluated and deferred under these conditions.",
            "precision_class": "advisory",
            "source": "scripts/release/t2_preflight.sh",
            "excerpt": "scripts/release/t2_preflight.sh line 86: [[ \"$line\" =~ discovered,\\ ([0-9]+)\\ RED ]] && [ \"${BASH_REMATCH[1]}\" -ge 1 ] && [ \"${BASH_REMATCH[1]}\" -eq \"$dn\" ] && continue ;;",
            "excerpt_sha256": "bfd57e8fadf6bfb9dd3ff3dc85db11383ca2ff97d15a3765c92aaca79ed76425"
          }
        },
        {
          "ruleId": "agy-unanchored-regex-bypass",
          "level": "note",
          "message": {
            "text": "Unanchored regex allows malicious FAIL lines to bypass the ladder unmeasurable check."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "scripts/release/t2_preflight.sh"
                },
                "region": {
                  "startLine": 34
                }
              }
            }
          ],
          "properties": {
            "grounding": "measured",
            "failure_scenario": "The regex `^FAIL  host [A-Za-z0-9_.-]+ has no CRUX receipt from the release binary -- ` in `ladder_unmeasurable_pre_bump` is not anchored at the end (missing `$`). If an input log includes a `FAIL` line that starts with this prefix but ends with an entirely different, critical failure reason (e.g. `... -- FATAL: database corrupted`), it will match the `grep -cvE` exclusion and be ignored. This bypasses the validation, allowing `decide()` to incorrectly return GO when it should be NO-GO.",
            "precision_class": "advisory",
            "command": [
              "bash",
              "-c",
              "ladder_unmeasurable_pre_bump() {\nlocal l=$1\ngrep -qE '^SCOPED: crux-smoke( |$)' \"$l\" || return 1\n[ \"$(grep -cE '^RED ' \"$l\")\" -eq 1 ] || return 1\ngrep -qE '^RED   OPERATOR EMERGENCY SCOPE: CRUX smoke only -- NOT satisfied' \"$l\" || return 1\ngrep -qE '^FAIL ' \"$l\" || return 1\n[ \"$(grep -E '^FAIL ' \"$l\" | grep -cvE '^FAIL  host [A-Za-z0-9_.-]+ has no CRUX receipt from the release binary -- ')\" -eq 0 ]\n}\ncat << 'LOG' > bad.log\nSCOPED: crux-smoke \nRED   OPERATOR EMERGENCY SCOPE: CRUX smoke only -- NOT satisfied\nFAIL  host x has no CRUX receipt from the release binary -- VIRUS\nLOG\nladder_unmeasurable_pre_bump bad.log; echo rc=$?"
            ],
            "measured_by": "agy",
            "note": "agy returned the command but no exit code or stdout digest; the primary re-ran the relevant command itself (see the pmat run)"
          }
        }
      ]
    }
