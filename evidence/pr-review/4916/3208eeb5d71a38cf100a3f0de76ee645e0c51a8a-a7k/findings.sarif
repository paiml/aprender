              }
            }
          ],
          "properties": {
            "grounding": "measured",
            "failure_scenario": "bashrs lint reports SC1044 on the arithmetic shift at parity_test.sh:544, reading it as a heredoc; no gate fails today because make lint-scripts covers scripts/*.sh only and ci.yml runs no bashrs, but extending lint to scripts/tests/ would turn this into a red build on correct code."
          }
        },
