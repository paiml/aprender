{
  "$schema": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/errata01/os/schemas/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "pmat"
        }
      },
      "invocations": [
        {
          "executionSuccessful": true,
          "toolExecutionNotifications": []
        }
      ],
      "results": [
        {
          "ruleId": "complexity_not_measurable",
          "level": "note",
          "message": {
            "text": "pmat has no analyzer for .yaml; the diff is two YAML files, so complexity_delta and tdg_delta are empty because nothing was measured, not because they are zero."
          },
          "properties": {
            "grounding": "asserted",
            "rationale": "pmat analyze complexity skips YAML (same measured result recorded in evidence/pr-review/4660 for .yml); not re-run here.",
            "failure_scenario": "A reader could take an empty complexity_delta as a measured zero; for a YAML-only diff it is unmeasured.",
            "precision_class": "advisory"
          }
        },
        {
          "ruleId": "mirror_byte_identical",
          "level": "note",
          "message": {
            "text": "contracts/thinking-budgets-v1.yaml and crates/apr-cli/contracts/thinking-budgets-v1.yaml are byte-identical at head (cmp prints nothing, exit 0)."
          },
          "properties": {
            "grounding": "measured",
            "command": [
              "cmp",
              "contracts/thinking-budgets-v1.yaml",
              "crates/apr-cli/contracts/thinking-budgets-v1.yaml"
            ],
            "exit_code": 0,
            "stdout_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
            "failure_scenario": "If the mirror drifted, the binary (include_str! of the mirror) would refuse with different text than the linted source; cmp shows no drift.",
            "precision_class": "advisory"
          }
        },
        {
          "ruleId": "parsed_yaml_diff_only_two_keys",
          "level": "note",
          "message": {
            "text": "Parsing base (316dee2cd4) and head with yaml.safe_load and walking both trees reports exactly two differing paths, both under models/Qwen3.5-0.8B-IQ4_XS.gguf: owed_by and why_unmeasured. No budget, basis, default, or any other model key changed, and no budget key was added to that entry."
          },
          "properties": {
            "grounding": "measured",
            "command": [
              "python3",
              "pd.py"
            ],
            "exit_code": 0,
            "stdout_sha256": "59ce1959a3648d5502b80d663d197c1d6532ea8c2bdc5a0ab6b9352067d0c87a",
            "failure_scenario": "If a budget key had been added to the IQ4_XS entry, thinking_on_budget_row would return Ok and the fail-closed refusal would end; the walk shows it was not.",
            "precision_class": "advisory"
          }
        },
        {
          "ruleId": "golden_output_reads_only_budget_basis_why",
          "level": "note",
          "message": {
            "text": "Every serde_yaml get on a models row or the default row in golden_output.rs reads only budget, why_unmeasured or basis (5 sites: lines 363,365,376,411,414). owed_by is read by no Rust, shell, python or workflow file (git grep over the tree). So the changed owed_by text affects no code path, and why_unmeasured is only interpolated into the Err refusal message after the budget lookup has already failed."
          },
          "properties": {
            "grounding": "measured",
            "command": [
              "git",
              "grep",
              "-n",
              "v.get(|d.get(|.get(budget|.get(basis|.get(why",
              "--",
              "crates/apr-cli/src/commands/golden_output.rs"
            ],
            "exit_code": 0,
            "stdout_sha256": "62ddef45ea0d960847cb904aa1650a53b4199277645866292738a014793f5047",
            "failure_scenario": "If another reader consumed owed_by or a new key, the prose change could alter behaviour; none does.",
            "precision_class": "advisory"
          }
        }
      ]
    },
    {
      "tool": {
        "driver": {
          "name": "antigravity"
        }
      },
      "invocations": [
        {
          "executionSuccessful": true,
          "toolExecutionNotifications": []
        }
      ],
      "results": [
        {
          "ruleId": "agy_run1_invalid_empty_sources",
          "level": "note",
          "message": {
            "text": "First agy run (gemini-3.1-pro-high, 405 s) is superseded and not counted: a zsh dollar-H-colon-path modifier error left the two source files in the disposable tree empty (0 bytes), and it returned one asserted finding about verify_output/gibberish_repeated_fragment, a layer this diff does not touch and which runs after the budget refusal. The recorded run is the second, with both files populated (6092 and 108659 bytes), which returned reviewed=true and zero findings."
          },
          "properties": {
            "grounding": "asserted",
            "rationale": "disclosure of a discarded run so the zero-finding result is not read as the only attempt; the discarded finding concerns pre-existing verify_output behaviour, not a line of this diff.",
            "failure_scenario": "Omitting the first run would hide that a cross-vendor reviewer once disagreed; recorded so the divergence is visible.",
            "precision_class": "advisory"
          }
        }
      ]
    },
    {
      "tool": {
        "driver": {
          "name": "cargo-mutants"
        }
      },
      "invocations": [
        {
          "executionSuccessful": false,
          "toolExecutionNotifications": [
            {
              "level": "error",
              "message": {
                "text": "No mutation run was executed. cargo-mutants 27.0.0 is installed (probe exit 0), but this review lane ran on lambda where the operator instruction forbids cargo builds, and a mutation run compiles and tests the workspace. The diff changes no Rust and no falsifier, only prose in a contracts/*.yaml that the guard path-triggers S3.D on; the author ran thinking_budgets_mirror 2/2 and apr-cli lib 108/108 on intel. Not consulted, so DEGRADED, never a clean mutation result."
              },
              "properties": {
                "grounding": "measured",
                "command": [
                  "cargo",
                  "mutants",
                  "--version"
                ],
                "exit_code": 0,
                "stdout_sha256": "c92db7e867b1f14d92c3c5bf1607f10f273a68e2d1cc9e57fb5b3ea4b8fe47a7",
                "failure_scenario": "Reading a not-run mutation consultation as clean would pass a contracts/*.yaml edit with no kill-rate evidence; for a prose-only edit there are no mutants in the diff to kill, but that is a judgement, so it is recorded as unreachable.",
                "precision_class": "advisory"
              }
            }
          ]
        }
      ],
      "results": []
    }
  ]
}
