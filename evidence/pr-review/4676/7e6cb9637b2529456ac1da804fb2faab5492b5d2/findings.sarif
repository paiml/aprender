     "ruleId": "review.mirror-byte-identical",
     "level": "note",
     "message": {
      "text": "Both contract copies are byte-identical at head 7e6cb9637b (cmp rc 0); the delta since the first review applies the same one-line comment edit to both."
     },
     "properties": {
