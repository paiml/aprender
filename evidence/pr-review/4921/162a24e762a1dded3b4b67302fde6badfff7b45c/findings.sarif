          "ruleId": "mutant-survived-running-rm",
          "level": "warning",
          "message": {
            "text": "Mutant A6 SURVIVED: deleting the worker's rm of its .running file (scripts/guard_tree.sh:317) leaves all 9 rows green, and the run's output is byte-identical to the unmutated run (same stdout digest as the baseline). No row checks that the heartbeat stops naming a check once it returns."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "scripts/guard_tree.sh"
