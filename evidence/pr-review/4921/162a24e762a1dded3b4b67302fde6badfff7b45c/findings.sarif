            "stdout_sha256": "02dc432a5d11a51e300ffdacfe57be2303f5fbed80560a62302f509df3e58906",
            "failure_scenario": "If a later edit breaks the reaper (a wrong WORK match, a dropped kill), the check still passes and fake serves leak on the runner again, unseen until a host fills up with them.",
            "precision_class": "advisory"
          }
        }
