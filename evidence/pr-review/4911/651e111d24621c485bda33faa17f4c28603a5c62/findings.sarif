      "results": [
        {
          "ruleId": "agy-routing-and-refusal-correctness",
          "level": "note",
          "message": {
            "text": "The routing correctly uses 'adapter_slot' to map q_proj to 2*layer and v_proj to 2*layer+1 by checking the name string. The all-or-nothing refusal correctly validates all tensors, buffers valid ones in a 'placed' Vec, and strictly checks if 'unplaced.is_empty()' before mutating 'lora_layers'. Length mismatch correctly rejects placement because of 'slot_len(...) == Some(data.len())'."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "crates/aprender-train/src/finetune/instruct_pipeline/constructors.rs"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ],
          "properties": {
            "grounding": "asserted",
            "precision_class": "advisory",
            "failure_scenario": "If tensors were written sequentially as parsed, an invalid tensor (e.g., wrong length or unknown projection) later in the file would leave the adapter partially applied, resulting in corrupted model weights and inconsistent states.",
            "rationale": "agy judgement. agy marked this cited, but returned no excerpt digest or exit code, so the primary records it as asserted; reverified_by_primary is false."
          }
        },
        {
          "ruleId": "agy-tests-falsify-defects",
          "level": "note",
          "message": {
            "text": "The test suite successfully runs and verifies the planted defects. The tests assert both that an explicit Err is returned and that the layers snapshot remains entirely unchanged. Consequently, any defect dropping the length check, routing using the old rule, or writing tensors eagerly would turn the tests RED."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "crates/aprender-train/src/finetune/instruct_pipeline/constructors.rs"
