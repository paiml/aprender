              "--",
              "crates/aprender-train/src/finetune/instruct_pipeline/*.rs"
            ],
            "exit_code": 0,
            "stdout_sha256": "36de40dcd70bbc9228d420518dd13a40f569412868b01c48c05ba80e5453186d",
            "failure_scenario": "A later edit swallows the inject error (for example to restore the warn-and-continue shape of the sibling arm), and the pipeline again loads a misrouted adapter with every test green.",
            "precision_class": "advisory"
          }
        },
        {
          "ruleId": "contract-validates",
          "level": "note",
          "message": {
            "text": "pv validate contracts/lora-target-selection-v1.yaml: 0 errors, 0 warnings, valid. The new equation adapter_routing matches the code as read: slot 2*layer + [v_proj], A or B by whole-component lora_A/lora_B, length equal to the slot, unique slot, and every tensor placed before any is written. contracts.nt changes only the version literal 1.0.0 to 1.1.0."
          },
