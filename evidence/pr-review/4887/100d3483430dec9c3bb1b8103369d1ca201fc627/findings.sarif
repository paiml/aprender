        {
          "ruleId": "t1-parity-choom-and-reason-unguarded",
          "level": "warning",
          "message": {
            "text": "The guard pins the flock only. Deleting 'choom -n 1000 --' from the parity call and deleting the exit-75 reason line each leave the guard at PASS, 11 of 11 killed. Unchanged since the second round."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "scripts/check_release_t1_lanes_joined.sh"
                },
                "region": {
                  "startLine": 138
                }
              }
            }
          ],
          "properties": {
            "grounding": "measured",
            "command": [
              "bash",
              "scripts/check_release_t1_lanes_joined.sh",
              "<mutated check_model_parity.sh>"
            ],
            "exit_code": 0,
            "stdout_sha256": "aa27c50cf30294c9807b70c19836871bf94f85a27c6a5bd33d5c2426a06b58c0",
            "failure_scenario": "A later edit drops choom or the reason and the guard stays green.",
            "precision_class": "advisory"
          }
        },
        {
          "ruleId": "t1-dirs-passes-a-commented-export",
          "level": "warning",
          "message": {
            "text": "dirs() reads the first line matching export CARGO_TARGET_DIR= inside t1_deep and t1_dogfood, with no check that the line is code. A commented-out export passes it: dirs returns 0 on an autopilot whose t1_deep export is commented, and deep then builds into the shared target dir the guard exists to prevent. The shared-deep mutant deletes the line and is killed; a comment is not. Fix: skip lines whose first non-space character is #."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "scripts/check_release_t1_lanes_joined.sh"
                },
                "region": {
                  "startLine": 128
                }
              }
            }
          ],
          "properties": {
            "grounding": "measured",
            "command": [
              "bash",
              "cm_dirs.sh",
              "<autopilot with deep export commented>"
            ],
            "exit_code": 0,
            "stdout_sha256": "54f945b0240728dc6b84b8866874a871b8d6fbc67affbdb843a75cff58920704",
            "failure_scenario": "A developer comments the export while debugging; the guard stays green and deep and dogfood race on one target dir.",
            "precision_class": "advisory"
          }
        }
      ]
    },
    {
      "tool": {
        "driver": {
          "name": "antigravity",
          "version": "1.3.0"
        }
      },
      "invocations": [
        {
          "executionSuccessful": true,
          "toolExecutionNotifications": []
        }
      ],
      "results": [
        {
          "ruleId": "agy-F01",
          "level": "warning",
          "message": {
            "text": "The `dirs()` guard function blindly passes on commented-out `CARGO_TARGET_DIR` exports."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "scripts/check_release_t1_lanes_joined.sh"
                },
                "region": {
                  "startLine": 128
                }
              }
            }
          ],
          "properties": {
            "grounding": "asserted",
            "rationale": "agy mark measured. Re-marked asserted: agy supplied no command or stdout digest. The primary reproduced it (t1-dirs-passes-a-commented-export): agreed.",
            "failure_scenario": "If a developer comments out `export CARGO_TARGET_DIR=...` in `t1_deep` or `t1_dogfood`, the `awk` regex will still match the commented line, resulting in a vacuous pass. This causes a target-dir collision as the lane will build in the shared target directory, but the guard will fail to prevent the merge.",
            "precision_class": "advisory"
          }
        },
        {
          "ruleId": "agy-F02",
          "level": "note",
          "message": {
            "text": "Interrupting the autopilot leaves the remote `models` build and measurement as an orphaned process."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "scripts/release/autopilot.sh"
                },
                "region": {
                  "startLine": 186
                }
              }
            }
          ],
          "properties": {
            "grounding": "asserted",
            "rationale": "agy mark cited. Same defect as the primary t1-interrupt-still-kills-models: agreed. The primary judged it deliberate and documented.",
            "failure_scenario": "When `autopilot.sh` is interrupted by `INT` or `TERM`, the trap sends `TERM` to the `models` lane's process group. This terminates the local `ssh` client. However, because the SSH session was started without a PTY, the remote SSH daemon does not send `SIGHUP` or `TERM` to the remote `bash -s` process. The remote host is left with an orphaned measurement script consuming GPU resources.",
            "precision_class": "advisory"
          }
        }
      ]
    }
  ]
