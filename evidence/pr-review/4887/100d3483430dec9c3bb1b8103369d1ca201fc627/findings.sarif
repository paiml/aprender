      "results": [
        {
          "ruleId": "t1-lanes-fixes-hold-on-main",
          "level": "note",
          "message": {
            "text": "Re-verified on the merged head, whose three scripts are byte-identical to 04fbad0de5 (git diff shows no change). Two lanes that exit 1 by themselves in one second are both RED and both named, models GO, rc 1. The guard passes 8 cases and 11 of 11 mutants in the default mode and under RELEASE_T1_LANES_ENFORCE=1, rc 0 both. Parity takes the GPU lock under choom with a lock-timeout reason (read; the busy-lock probe was run on the previous heads and the file is unchanged)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "scripts/release/autopilot.sh"
                },
                "region": {
                  "startLine": 196
                }
              }
            }
          ],
          "properties": {
            "grounding": "measured",
            "command": [
              "bash",
              "t1_join_race_probe.sh",
              "<scratch>"
            ],
            "exit_code": 0,
            "stdout_sha256": "40ac0c0c06854ae8bdf1c8fe3f8f7b7282c6f763444ee374d1c0ec17d1a6f010",
            "failure_scenario": "none: earlier findings closed. The guard digest in the notes is the default-mode run; the enforce run gives the same result.",
            "precision_class": "advisory"
          }
        },
        {
          "ruleId": "t1-interrupt-still-kills-models",
          "level": "note",
          "message": {
            "text": "INT/TERM to the autopilot sends TERM to every lane's group including models; the stub models child is gone. The comment documents it as the operator's choice. Judged deliberate and acceptable; the remote ssh leg may run on in the release dir and nothing in the guard pins the kill or a cleanup. Unchanged."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "scripts/release/autopilot.sh"
                },
                "region": {
                  "startLine": 186
                }
              }
            }
          ],
          "properties": {
            "grounding": "measured",
            "command": [
              "bash",
              "t1_int_probe.sh",
              "<scratch>"
            ],
            "exit_code": 0,
            "stdout_sha256": "94c67307c91994555bbcab3b3547265f3d64e899a10451b628dc24d2e23b7f25",
            "failure_scenario": "TERM while models runs leaves the remote build and ladder running; the next pass starts against it.",
            "precision_class": "advisory"
          }
        },
        {
          "ruleId": "t1-launch-window-race",
          "level": "note",
          "message": {
            "text": "An interrupt between a lane launch and its record leaves that lane out of the trap kill loop."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "scripts/release/autopilot.sh"
                },
                "region": {
                  "startLine": 188
                }
              }
            }
          ],
          "properties": {
            "grounding": "asserted",
            "rationale": "The primary read autopilot.sh:188: the trap is installed before the launch loop, but an interrupt between a lane being launched and recorded leaves it out of the kill loop. The window is microseconds; judged acceptable. Unchanged.",
            "failure_scenario": "INT in the microseconds after a lane starts leaves it running after the autopilot stops.",
            "precision_class": "advisory"
          }
        },
        {
          "ruleId": "t1-guard-nothing-enforces",
          "level": "note",
          "message": {
            "text": "Unchanged: no workflow, Makefile, script or contract sets RELEASE_T1_LANES_ENFORCE, so the guard blocks nowhere, as with the draft guard. Record a promotion date or a ticket."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "scripts/check_release_t1_lanes_joined.sh"
                },
                "region": {
