          ],
          "properties": {
            "grounding": "measured",
            "command": [
              "python3",
              "-c",
              "import yaml;d=yaml.safe_load(open('.github/workflows/install-script.yml'));print(sorted((d.get(True) or d.get('on')).keys()))"
            ],
            "exit_code": 0,
            "stdout_sha256": "d316f971713beea1aed9b69157b65655919784c6f3f1d820ddbda8dc299f551f",
            "precision_class": "advisory",
            "failure_scenario": "v0.68.0 is published with one asset missing or renamed. No watched path changed, so install-script.yml never runs, and the last green run of this gate certified v0.67.0's naming. The first report is a user's curl one-liner failing - which is the exact outcome the workflow header claims the gate prevents. A `release: [published]` trigger and/or a daily schedule would close it, and both cost one run."
          }
        },
