        {
          "ruleId": "prompt-certification-carried",
          "level": "note",
          "message": {
            "text": "evidence/crux/0.70.3/prompt-certification.json and its inventory are byte copies of the evidence/crux/0.70.2 files (sha256 pairs equal). The certification apr_commit is the pre-0.70.2 commit, so the CRUX smoke at the 0.70.3 commit relies on a certification not re-run for this tag; the release notes disclose it. Carried from the receipt at bfdab9d30d and re-measured at this head."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "evidence/crux/0.70.3/prompt-certification.json"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ],
          "properties": {
            "grounding": "measured",
            "command": [
              "sha256sum",
              "evidence/crux/0.70.2/prompt-certification.json",
              "evidence/crux/0.70.3/prompt-certification.json",
              "evidence/crux/0.70.2/prompt-certification-inventory.json",
              "evidence/crux/0.70.3/prompt-certification-inventory.json"
            ],
            "exit_code": 0,
            "stdout_sha256": "65e583e3b59c6f74055639aa1a3a505e17cd0759d66d8e7b56eace609db47364",
            "failure_scenario": "If a certified model file or prompt changed between 0.70.2 and 0.70.3, the smoke would run against prompts certified for different bytes; the carried copy cannot detect that, only the pinned sha256 inside it can.",
            "precision_class": "advisory",
            "carried_from": "4715d5e1c4d3957b06a8381880a525dabd2117ed (diff patch-id unchanged, 167b82dd43a33f3e0838c9e6ff59b1cba3266afd)"
