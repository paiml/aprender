            "rationale": "Reviewer judgement from the enum definition and module visibility; no semver-check tool was run.",
            "failure_scenario": "A downstream crate that matches FinishReason with Stop and Length arms and no wildcard stops compiling when it takes 0.70.3.",
            "precision_class": "advisory",
            "carried_from": "4715d5e1c4d3957b06a8381880a525dabd2117ed (diff patch-id unchanged, 167b82dd43a33f3e0838c9e6ff59b1cba3266afd)"
          }
