        {
          "ruleId": "tail-flush-order-preserved",
          "level": "note",
          "message": {
            "text": "Reading the diff of 95f64ba144 against its parent: the old inline block ran tail_deltas, detect over each tail delta, finish(detector), content events for tail then end.content, finish_reason(calls, from_generation(filter.stopped(), ...)), then one tool_calls chunk. live_tail_events does the same detect, finish, extend-with-held-text, finish_reason, content events, tool_calls chunk, and returns the events for the caller to yield in that order. from_generation is still read after tail_deltas has run filter.finish(), so the stopped flag is read at the same point. tail Vec is built before the stop flag read, as before. The tests that drive this path (stream_tool_calls_4918.rs, sse_stream_stop_markers_4340.rs, sse_stream_whitespace.rs, openai_compat_2375.rs) were not run on this box."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "crates/aprender-serve/src/api/openai_handlers.rs"
                },
                "region": {
                  "startLine": 1068
                }
              }
            }
          ],
          "properties": {
            "grounding": "asserted",
            "rationale": "Reviewer comparison of the removed and added lines of the commit; no test was run (cargo test is not permitted here), so behavioural equality rests on the reading and on clippy exit 0.",
            "failure_scenario": "If the order differed, a client would see the tool_calls chunk after the terminal finish chunk or content after the tool call; the commit keeps the same sequence, so this is a no-defect note.",
            "precision_class": "advisory",
            "carried_from": "4715d5e1c4d3957b06a8381880a525dabd2117ed (diff patch-id unchanged, 167b82dd43a33f3e0838c9e6ff59b1cba3266afd)"
          }
        },
