        {
          "ruleId": "public-enum-variant-in-patch-release",
          "level": "warning",
          "message": {
            "text": "Carried from the receipt at bfdab9d30d; run_report.rs is untouched by the later commits. FinishReason is a pub enum reachable as realizar::infer::run_report::FinishReason and is not #[non_exhaustive]. The ToolCalls variant breaks any downstream exhaustive match in a 0.70.x patch release. No in-repo exhaustive match exists, so the workspace builds, but crates.io consumers are not covered by that search."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "crates/aprender-serve/src/infer/run_report.rs"
                },
                "region": {
                  "startLine": 37
                }
              }
            }
