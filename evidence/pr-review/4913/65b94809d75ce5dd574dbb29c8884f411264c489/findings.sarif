            "exit_code": 0,
            "stdout_sha256": "d162ed5dc6385a3ba3d62e6d167c0fd9e2c534b92fdbd22eef7f449d9e588435",
            "failure_scenario": "none: every planted mutant of the guard and the registry turned the two totality tests RED.",
