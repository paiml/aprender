      "results": [
        {
          "ruleId": "diff-patch-id-matches-arm4",
          "level": "warning",
          "message": {
            "text": "The patch-id of merge-base ad8fafc794..head 49ff6df5b8 with evidence/pr-review excluded, computed with scripts/lib/pr_review_patch_id.sh prpid_compute the way arm4 does (git-patch-id-verbatim/pinned-diff-v1), is a51081c3f671e602b73e42436c66c1452ff34f49. The id supplied with the task, 93e3ea5b32355b5044820120417e30cf3a5340f8, was a --stable id and differs; arm4 hashes with the verbatim algorithm, so the receipt carries a51081c3f671e602b73e42436c66c1452ff34f49. A direct git patch-id --stable recompute was refused by the lane hook and is not run."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "scripts/lib/pr_review_patch_id.sh"
                },
                "region": {
                  "startLine": 100
                }
              }
            }
          ],
          "properties": {
            "grounding": "measured",
            "command": [
              "bash",
              "-c",
              ". scripts/lib/pr_review_patch_id.sh && prpid_compute \"$PWD\" ad8fafc7943962aceefd1eff18cac65d6cb35f46 49ff6df5b8e7ce1d94d6a28017ead1298b83cbc3 4935"
            ],
            "exit_code": 0,
            "stdout_sha256": "407540d0fa79134bf15dfe736347e620aded4b450643593406e22afecfb227bb",
            "failure_scenario": "A receipt stamped with the stable id would match no arm4 A2 recompute, so the present check would find no receipt for the subject and fail.",
            "precision_class": "advisory"
          }
        },
        {
