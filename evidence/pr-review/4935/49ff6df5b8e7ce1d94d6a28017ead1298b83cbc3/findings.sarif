            "failure_scenario": "none: a surviving mutant would leave a stated rule that nothing tests; none survived.",
            "precision_class": "advisory"
          }
        },
        {
          "ruleId": "cascade-step-hands-down-step5-receipts",
          "level": "note",
          "message": {
            "text": "Step 6 passes the same two values step 5 passes to check_publish_preflight.sh (MODEL_LADDER_CRUX_DIR=$AP/models-t1, CRUX_CERT=$WT/evidence/crux/$V/prompt-certification.json), only when AP_POLICY=1; the else branch is the unchanged bare call. cascade-drain.sh line 151 unsets only CARGO_REGISTRY_TOKEN, so the two variables reach cascade-publish.sh and its preflight. The scripts/cascade-publish.sh change is comment only (bash -n clean on all three files)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "scripts/release/autopilot.sh"
                },
                "region": {
                  "startLine": 513
                }
