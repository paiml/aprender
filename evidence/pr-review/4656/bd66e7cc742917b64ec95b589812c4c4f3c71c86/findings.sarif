{
 "$schema": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/errata01/os/schemas/sarif-schema-2.1.0.json",
 "version": "2.1.0",
 "runs": [
  {
   "tool": {
    "driver": {
     "name": "pmat"
    }
   },
   "invocations": [
    {
     "executionSuccessful": true,
     "toolExecutionNotifications": []
    }
   ],
   "results": [
    {
     "ruleId": "repro_red_without_safe_directory",
     "level": "note",
     "message": {
      "text": "PASS (red reproduced): root container over a uid-1000 /workspace with refs/remotes/origin/main pinned: git exits 128 'detected dubious ownership'"
     },
     "properties": {
      "grounding": "measured",
      "command": [
       "docker",
       "run",
       "--rm",
       "--entrypoint",
       "bash",
       "-v",
       "<tmp>/w:/workspace",
       "-w",
       "/workspace",
       "rust-cuda:1.95.0-cuda12.8",
       "-c",
       "id -u; git rev-parse \"origin/main^{commit}\""
      ],
      "exit_code": 128,
      "stdout_sha256": "9a271f2a916b0b6ee6cecb2426f0b3206ef074578be55d9bc94f6f3fe3ab86aa",
      "failure_scenario": "If git resolved origin/main here the claimed root cause would be wrong and the fix a no-op.",
      "precision_class": "advisory"
     }
    },
    {
     "ruleId": "repro_green_with_safe_directory",
     "level": "note",
     "message": {
      "text": "PASS (green): same container plus -e GIT_CONFIG_COUNT=1 -e GIT_CONFIG_KEY_0=safe.directory -e GIT_CONFIG_VALUE_0=/workspace: git exits 0 and prints baa592146f96e7575bafd0ada0e0f201fabe3a72 (the pinned commit)"
     },
     "properties": {
      "grounding": "measured",
      "command": [
       "docker",
       "run",
       "--rm",
       "--entrypoint",
       "bash",
       "-e",
       "GIT_CONFIG_COUNT=1",
       "-e",
       "GIT_CONFIG_KEY_0=safe.directory",
       "-e",
       "GIT_CONFIG_VALUE_0=/workspace",
       "-v",
       "<tmp>/w:/workspace",
       "-w",
       "/workspace",
       "rust-cuda:1.95.0-cuda12.8",
       "-c",
       "id -u; git rev-parse \"origin/main^{commit}\""
      ],
      "exit_code": 0,
      "stdout_sha256": "b5898a0955b34a8e0bc98c98df7b84d660c0406f388e908aaf4895b41ee1256f",
      "failure_scenario": "If green still failed the env vars would not fix the quick-tier step.",
      "precision_class": "advisory"
     }
    },
    {
     "ruleId": "diff_only_adds_env",
     "level": "note",
     "message": {
      "text": "PASS: bd66e7cc74 changes ci/sections.yml by +2 lines, both the safe.directory -e flags on the two quick-tier docker run steps; 0 deletions; no skip/continue-on-error/threshold text in added lines; same flags as the full-tier step at :484"
     },
     "properties": {
      "grounding": "measured",
      "command": [
       "bash",
       "-c",
       "git diff bd66e7cc74~1 bd66e7cc74 --numstat"
      ],
      "exit_code": 0,
      "stdout_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "failure_scenario": "A removed or edited gate line in the same hunk would loosen the gate.",
      "precision_class": "advisory"
     }
    },
    {
     "ruleId": "guards_on_sections_yml",
     "level": "note",
     "message": {
      "text": "PASS: 13 guards that read ci/sections.yml or the workflows all exit 0 (check_workflow_env_defined, check_ci_fat_secrets_plumbed, check_guards_are_wired, check_fat_secrets_passed, check_explicit_test_commands, check_no_timing_in_required, check_guard_steps_run_all, check_guard_steps_isolated, check_coverage_has_producers, check_ci_reusable_workflow_pinned, check_workflow_cargo_packages, check_workflow_path_filters, check_pr_workflows_cancel_superseded)"
     },
     "properties": {
      "grounding": "measured",
      "command": [
       "bash",
       "scripts/check_*.sh"
      ],
      "exit_code": 0,
      "stdout_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "failure_scenario": "A guard failing would block the merge or mean the edit broke an invariant.",
      "precision_class": "advisory"
     }
    },
    {
     "ruleId": "ci_yml_not_generated",
     "level": "note",
     "message": {
      "text": "PASS: .github/workflows/ci.yml is hand-maintained and reads ci/sections.yml at runtime (scripts/ci/fat_driver.py); no generator or regen step exists, so no second file is out of sync"
     },
     "properties": {
      "grounding": "measured",
      "command": [
       "grep",
       "-n",
       "sections.yml",
       ".github/workflows/ci.yml"
      ],
      "exit_code": 0,
      "stdout_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "failure_scenario": "A generated ci.yml left stale would run the old steps.",
      "precision_class": "advisory"
     }
    }
   ],
   "properties": {
    "note": "primary-reviewer measured checks of the quick-tier safe.directory delta; the guard driver vocabulary has no slot for docker/git, so they ride on the pmat run"
   }
  }
 ]
}
