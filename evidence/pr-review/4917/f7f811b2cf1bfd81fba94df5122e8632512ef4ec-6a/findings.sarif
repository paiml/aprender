            "precision_class": "advisory"
          }
        },
        {
          "ruleId": "python-grew-in-a-port-pr",
          "level": "note",
          "message": {
            "text": "The three Python files the port retires grew in this PR: +850 / -440 lines (the helper split for the pre-commit complexity hook). No new .py file is added. Both hermetic case tables pass on the head, so the split did not break any row they hold. Under the no-new-Python rule, the growth is the port being kept alive twice until 0.71+1."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "scripts/lib/crux_inference_judge.py"
                },
                "region": {
                  "startLine": 11
