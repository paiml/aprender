      "results": [
        {
          "ruleId": "judge-binary-has-no-caller",
          "level": "warning",
          "message": {
            "text": "Nothing in the tree runs the new binary. scripts/lib/crux_judge_bin.sh is sourced by no .sh, .yml or Makefile (git grep exits 1), while 2 drivers (crux_inference_dogfood.sh:826, crux_sweep_shards.sh:171) still run python3 scripts/lib/crux_inference_judge.py collect. The helper header says the binary replaced the three Python files; at this head it replaces none. PMAT-4802 lists caller migration as acceptance, and its status is inprogress, so this may be the intended split. But the byte-identical claim in the README is then checked by nothing in this PR."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "scripts/lib/crux_judge_bin.sh"
                },
                "region": {
                  "startLine": 8
                }
              }
            }
          ],
          "properties": {
            "grounding": "measured",
            "command": [
              "git",
              "grep",
              "-n",
              "-e",
              "scripts/lib/crux_judge_bin.sh",
              "-e",
              "CRUX_JUDGE}",
              "-e",
              "\"$CRUX_JUDGE\"",
              "--",
              "*.sh",
              "*.yml",
              "Makefile",
              ":!scripts/lib/crux_judge_bin.sh"
            ],
            "exit_code": 1,
            "stdout_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
            "failure_scenario": "The Rust judge drifts from the Python judge it claims parity with, and no run notices until a caller is switched: 9.8k lines that no gate executes.",
            "precision_class": "advisory"
          }
        },
        {
          "ruleId": "crate-built-by-no-gate",
          "level": "warning",
          "message": {
            "text": "No workflow, ci/ file or Makefile names crux-judge or crux_judge (git grep exits 1), and the crate is in the workspace exclude list. So cargo test, clippy, and the unwrap ban its own clippy.toml carries never run on it in CI. That ban is the reason PMAT-4802 gives for converting 48 unwraps."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Cargo.toml"
                },
                "region": {
                  "startLine": 129
                }
              }
            }
