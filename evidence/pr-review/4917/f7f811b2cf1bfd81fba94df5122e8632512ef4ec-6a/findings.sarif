            "stdout_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
            "failure_scenario": "A compile error or a failing unit test in tools/aprender-crux-judge merges green; the first build is the nightly that switches a caller over.",
            "precision_class": "advisory"
          }
        },
        {
          "ruleId": "binary-debt-reason-names-a-nightly-that-does-not-run-it",
          "level": "note",
          "message": {
            "text": "The new contracts/binary-debt-v1.yaml row gives the reason \"run by the nightly only\". No nightly runs it: no workflow names the crate, and every CRUX driver calls the Python judge. The ledger row states a fact that is false at this head."
          },
