      "results": [
        {
          "ruleId": "judge-binary-has-no-caller",
          "level": "warning",
          "message": {
            "text": "Nothing in the tree runs the new binary. Every .sh/.yml/Makefile that names a CRUX judge at this head names the Python modules (check_crux_inference_judge.sh, check_crux_oracles.sh, crux_inference_dogfood.sh, crux_sweep_shards.sh, lib/crux_cells_serve_code.sh); crux_judge_bin.sh is sourced by none. Two comments state the opposite: crux_judge_bin.sh:8 says the binary \"replaced\" the three .py files and main.rs:10 calls them \"retired\", while the crate README says they stay until N-1. The README is right; the two comments are not."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "scripts/lib/crux_judge_bin.sh"
                },
                "region": {
                  "startLine": 8
                }
              }
            }
          ],
          "properties": {
            "grounding": "measured",
            "precision_class": "advisory",
            "command": [
              "bash",
              "-c",
              "sed -n \"8p\" scripts/lib/crux_judge_bin.sh; sed -n \"10p\" tools/aprender-crux-judge/src/main.rs; git grep -l -E \"crux_(inference_judge|oracles|prompt_certify)\\.py\" HEAD -- \"*.sh\" \"*.yml\" Makefile"
            ],
            "exit_code": 0,
            "stdout_sha256": "df685ddce70e3b98a7ea6a0a39acd7dfe35e68ea538586fd510b48d7b3d258c2",
            "failure_scenario": "A reader of crux_judge_bin.sh or main.rs believes the Rust judge is the live path and debugs it while the gates run the Python; the Rust judge drifts from the Python and no run notices until a caller is switched."
          }
        },
        {
