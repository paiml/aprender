        {
          "ruleId": "truncation-row-pruned-but-slice-remains",
          "level": "warning",
          "message": {
            "text": "The one delta since f7f811b2cf prunes the baseline row for crux_inference_judge.py `e[\"why\"] = ... % p[\"answer\"][:24]`. The guard calls it stale and passes (79 candidates). But the slice is not gone: the helper split moved it to line 645 as `return True, \"degenerate output ...: %r\" % p[\"answer\"][:24]`, and that line is no longer a candidate. truncation_scan.py keeps a line only if it also matches STRINGY, and the moved line lost the word `why` and uses `%r`, which STRINGY does not list. So the prune is mechanically right and the enumeration under-counts: a known display-class truncation left the baseline without being removed. Fix: add `%r` to STRINGY (re-baseline the rows it adds), or re-add the row under a key the scan produces."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "scripts/lib/crux_inference_judge.py"
                },
                "region": {
                  "startLine": 645
                }
              }
            }
          ],
          "properties": {
            "grounding": "measured",
            "precision_class": "advisory",
            "command": [
              "bash",
              "-c",
              "bash scripts/check_no_silent_truncation.sh --list | LC_ALL=C /usr/bin/grep -c \"crux_inference_judge.py:645\"; LC_ALL=C /usr/bin/grep -n \"\\[:24\\]\" scripts/lib/crux_inference_judge.py"
            ],
            "exit_code": 0,
            "stdout_sha256": "02034b601891ba957dcbbcf810070ff7a0410924f263019bdde7d1b483dbdc3d",
            "failure_scenario": "A later edit widens or adds a `return ..., \"...%r\" % x[:N]` truncation in a reason string a human reads in the receipt; the scan never lists it, the guard passes, and the baseline shrank without the truncation it excused being removed."
          }
        }
