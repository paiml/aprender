{
  "$schema": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/errata01/os/schemas/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "pmat"
        }
      },
      "invocations": [
        {
          "executionSuccessful": true,
          "toolExecutionNotifications": []
        }
      ],
      "results": [
        {
          "ruleId": "no_existing_paginated_prune",
          "level": "note",
          "message": {
            "text": "pmat query at head for paginated deletion of stale release assets returns 5 results; the nearest is nightly_manifest.py publish, which lists one page only, and none paginates or prunes. The duplication scan searched 8 needles over 1376/1376 sibling branches with 0 hits."
          },
          "properties": {
            "grounding": "measured",
            "command": [
              "pmat",
              "query",
              "paginate release assets delete stale",
              "--limit",
              "5"
            ],
            "exit_code": 0,
            "stdout_sha256": "8b607c9c54be06b5796a61cbc2edc00cd53724230579ef1c29344a9e30dae4d5",
            "rationale": "No helper exists to reuse; the script fills the gap publish leaves past page one.",
            "failure_scenario": "If a paginated prune existed elsewhere, a second one would drift from it; none was found.",
            "precision_class": "advisory"
          }
        },
        {
          "ruleId": "plan_mirrors_publish_plan",
          "level": "note",
          "message": {
            "text": "The plan mirror selects green targets at SHA built by this run, as publish_plan does."
          },
          "properties": {
            "grounding": "cited",
            "source": "scripts/nightly_prune_release.sh at head, line 66",
            "excerpt": "      | select(.status == \"green\" and .green_sha == $sha and .built_run_id == $r)",
            "excerpt_sha256": "eb797e09f2aa3f3f39583a574fb88f67d7bd1881b67daac7e518139c8360115b",
            "rationale": "The jq select applies the three filters publish_plan applies at scripts/nightly_manifest.py:320, so only names publish re-uploads lose their old copy.",
            "failure_scenario": "If a filter were dropped, an asset outside the plan (red, stale sha, reused run) would be deleted and not replaced; mutants m4/m5/m6 each turn 2 self-test rows red.",
            "precision_class": "advisory"
          }
        },
        {
          "ruleId": "publish_plan_filter_source",
          "level": "note",
          "message": {
            "text": "publish_plan's own selection, cited as the reference the mirror is checked against."
          },
          "properties": {
            "grounding": "cited",
            "source": "scripts/nightly_manifest.py at head, line 320",
            "excerpt": "        if e[\"status\"] != \"green\" or e[\"green_sha\"] != sha or e.get(\"built_run_id\") != manifest[\"run_id\"]:",
            "excerpt_sha256": "a17d4cc48e1b62552ed9d0a0de37f08b40e430f45c6463e5396254b26cbc8ab2",
            "rationale": "This is the line the script mirrors; the review compared them field by field.",
            "failure_scenario": "A divergence here would let the prune delete what publish skips; both lanes found no divergence on a well-formed manifest.",
            "precision_class": "advisory"
          }
        },
        {
          "ruleId": "non_array_page_fails_closed",
          "level": "note",
          "message": {
            "text": "A 200 asset page that is not a JSON array exits nonzero."
          },
          "properties": {
            "grounding": "cited",
            "source": "scripts/nightly_prune_release.sh at head, line 88",
            "excerpt": "    jq -e 'type == \"array\"' <<< \"$batch\" >/dev/null 2>&1 || die \"assets page $page is not a JSON array\"",
            "excerpt_sha256": "7608f5eb023d469aabda327d4d11a5c06b58e87c74bd56e7c2efdb83eb1bbd59",
            "rationale": "Round 1 lane 1 (claude-sonnet-5-5) found a non-array 200 page read as the empty last page; this guard closes it and the self-test row answers {} so only the guard can catch it.",
            "failure_scenario": "Without the guard a {} page ends the listing early and past-page-one copies survive to a rename 422; mutant m1 turns 1 row red.",
            "precision_class": "advisory"
          }
        },
        {
          "ruleId": "exact_membership",
          "level": "note",
          "message": {
            "text": "Membership in the plan is an exact whole-line match."
          },
          "properties": {
            "grounding": "cited",
            "source": "scripts/nightly_prune_release.sh at head, line 110",
            "excerpt": "    if [[ \"$up\" == *$'\\n'\"$name\"$'\\n'* ]]; then",
            "excerpt_sha256": "4530bc84d68b9c99990c3a3b3de473a7cf6c6577f438f1aaa4ce7b95c192e08d",
            "rationale": "Membership is newline-delimited so a planned name that contains another as a substring does not match it.",
            "failure_scenario": "A substring match deletes a234 because a234.old is planned; mutant m10 turns 5 rows red.",
            "precision_class": "advisory"
          }
        },
        {
          "ruleId": "planted_question_rejected",
          "level": "note",
          "message": {
            "text": "Quorum round 3: unanimous PASS, degraded: same-family; planted question rejected by both lanes."
          },
          "properties": {
            "grounding": "cited",
            "source": "scripts/nightly_prune_release.sh at head, line 48",
            "excerpt": "  code=$(curl -sS --retry 3 --retry-all-errors -o \"$body\" -w '%{http_code}' -X \"$1\" \\",
            "excerpt_sha256": "69ab5e8cfedabc2709dad8169f0c84f2bc32ecaa16657c59e495cf062402f579",
            "rationale": "The planted contrary question Q3 claimed the script calls gh; both round-3 lanes (claude-sonnet-5-5, claude-haiku-4-5-20251001) rejected it and cited the curl call.",
            "failure_scenario": "A lane that accepted the false premise would void its vote; neither did.",
            "precision_class": "advisory"
          }
        },
        {
          "ruleId": "quorum_r3_lane1_sonnet",
          "level": "note",
          "message": {
            "text": "Round 3 lane 1, model claude-sonnet-5-5: PASS, planted Q3 rejected (cited curl at :48), mutation of its own choosing RED."
          },
          "properties": {
            "grounding": "cited",
            "source": "/mnt/nvme-raid0/cop-inbox/handoff/signoff-q-4777-prune.md, quorum receipt table, round 3 row",
            "excerpt": "| 3 | b5bf02e457 | 1 | claude-sonnet-5-5 | PASS | rejected (curl, :48) | yes | built_run_id filter dropped (:66), RED 2 |",
            "excerpt_sha256": "b2e676a4e164b6ebc7d07b798af2a424a73b6d23db38f4bd53244fa94af49339",
            "rationale": "Lane 1 verdict recorded on its own, with exact model id.",
            "failure_scenario": "Under C312-9 a same-family answer stands only if unanimous; a FAIL or a lane that accepted the planted premise in either row would void the review.",
            "precision_class": "advisory"
          }
        },
        {
          "ruleId": "quorum_r3_lane2_haiku",
          "level": "note",
          "message": {
            "text": "Round 3 lane 2, model claude-haiku-4-5-20251001: PASS, planted Q3 rejected (cited curl at :41-56), mutation of its own choosing RED."
          },
          "properties": {
            "grounding": "cited",
            "source": "/mnt/nvme-raid0/cop-inbox/handoff/signoff-q-4777-prune.md, quorum receipt table, round 3 row",
            "excerpt": "| 3 | b5bf02e457 | 2 | claude-haiku-4-5-20251001 | PASS | rejected (curl, :41-56) | yes | membership line :110 leading \\n dropped, RED 7 |",
            "excerpt_sha256": "7df753263e124afb3eb8cc01da485301ba76750a5389bf419eebedc8cbe5a219",
            "rationale": "Lane 2 verdict recorded on its own, with exact model id; with lane 1 it makes the vote unanimous (2/2 PASS).",
            "failure_scenario": "Under C312-9 a same-family answer stands only if unanimous; a FAIL or a lane that accepted the planted premise in either row would void the review.",
            "precision_class": "advisory"
          }
        }
      ]
    },
    {
