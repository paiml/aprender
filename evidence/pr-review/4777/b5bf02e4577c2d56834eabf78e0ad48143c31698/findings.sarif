            "source": "author mutant run at head b5bf02e457 (scripts/nightly_prune_release.sh --self-test)",
            "excerpt": "head: 21 ok, nightly_prune_release self-test: PASS",
            "excerpt_sha256": "33217b4d9b0db767ffea077dff8b6bfd2816b902b75428fd50e3dfdbb4437df6",
            "rationale": "The unmutated script passes all 21 self-test rows.",
            "failure_scenario": "If the self-test were vacuous, mutants would pass; see the next result.",
            "precision_class": "advisory"
          }
        },
        {
          "ruleId": "guard_mutants_all_red",
          "level": "note",
          "message": {
            "text": "10 of 10 guard mutants killed."
          },
          "properties": {
            "grounding": "cited",
            "source": "author mutant run at head b5bf02e457, 10 mutants",
            "excerpt": "m1-no-array-guard: nightly_prune_release self-test: FAIL (1)\nm2-dist-only: nightly_prune_release self-test: FAIL (6)\nm3-plan-read-open: nightly_prune_release self-test: FAIL (1)\nm4-no-status: nightly_prune_release self-test: FAIL (2)\nm5-no-sha: nightly_prune_release self-test: FAIL (2)\nm6-no-run: nightly_prune_release self-test: FAIL (2)\nm7-page-one-only: nightly_prune_release self-test: FAIL (10)\nm8-no-staged-purge: nightly_prune_release self-test: FAIL (2)\nm9-no-manifest-name: nightly_prune_release self-test: FAIL (1)\nm10-substring-match: nightly_prune_release self-test: FAIL (5)",
            "excerpt_sha256": "5dd9f7cabbb2ffc1c35f72e6d5cf22a63f76c5771ffebd2e3abc7d0e65695194",
            "rationale": "Each of 10 mutants (array guard, dist-only membership, plan read open, status/sha/run filters, page-one-only, staged purge, manifest name, substring match) turns the self-test red; each mutant copy parses.",
            "failure_scenario": "A surviving mutant would mark a row that cannot fail; none survived.",
            "precision_class": "advisory"
          }
        }
