    {
     "ruleId": "SESSION-SCORE-KV-CORRUPT",
     "level": "note",
     "message": {
      "text": "Session::score corrupts the KV cache for checkpoints because it calls advance_to without invalidating self.checkpoint [primary: CONTRADICTED -- Session::advance_to (session.rs:239-246) forwards through Session::step, and step() drops the checkpoint whenever start < checkpoint.len() (session.rs:299-302), so score() cannot bypass the invalidation.]"
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "crates/aprender-serve/src/session.rs"
        },
        "region": {
         "startLine": 483
        }
       }
      }
     ],
     "properties": {
      "grounding": "asserted",
      "rationale": "agy's own asserted claim, recorded verbatim; the primary read advance_to and step and contradicts it.",
      "failure_scenario": "If a user calls `score` with a sequence that overwrites the KV cache (e.g. from `start = 0`), `advance_to` bypasses the checkpoint clearing logic found in `advance_and_choose`, leaving `self.checkpoint` intact. When a subsequent `generate` call processes a prompt matching the checkpoint, `prepare_prompt` restores the checkpoint because the guard (`state.kv_len >= ckpt.kv_len`) passes vacuously (as `score` increased the KV length). The physical KV cache underneath was overwritten by the scored tokens, causing attention layers to attend to wrong tokens while recurrent layers use the restored state.",
      "precision_class": "advisory",
      "rationale_for_class": "S3.E is ADVISORY until 30 samples exist; this claim is additionally contradicted by the primary."
     }
    }
   ]
