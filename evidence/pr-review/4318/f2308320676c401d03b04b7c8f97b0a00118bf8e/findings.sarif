       "--head",
       "f2308320676c401d03b04b7c8f97b0a00118bf8e",
       "--rust-semantic",
       "--json",
       "/mnt/nvme-raid0/tmp/pr4318/dup.json"
      ],
      "exit_code": 0,
      "stdout_sha256": "fdb468577e5c8c7a61e5be2f269c21fc2cac0a9ee207907deb42958e5e70d8e4",
      "failure_scenario": "Two sha256-of-a-file helpers drift (one streams and errors, one io::copy's and returns None); a later fix to one misses the other, and the bench receipt and the F2 receipt name the same binary by diverging rules.",
      "precision_class": "advisory",
      "rationale_for_class": "The scan measures a name match; that the two are the same function is reviewer judgement from reading both bodies. DRY, not a correctness block."
     }
    },
    {
     "ruleId": "PRREV-4318-CKPT-STREAM-COMMENT",
     "level": "note",
     "message": {
      "text": "save_checkpoint/restore_checkpoint copy the recurrent state on executor.compute_stream(), while the layer kernels launch on the execution stream (the new execution_stream()). The comment at line 821 says the copy runs 'after every launch that wrote the state'; that ordering holds today only because the caller (Session::prepare_prompt) runs after forward() has synchronously downloaded logits, not because of any stream ordering in this function."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "crates/aprender-serve/src/gguf/cuda/forward_qwen35_cuda.rs"
        },
        "region": {
         "startLine": 821
        }
       }
      }
     ],
     "properties": {
      "grounding": "asserted",
      "rationale": "Read from the diff: two distinct stream handles, no event record/wait between them in save_checkpoint. Device ordering semantics could not be cited because the nvidia-cuda-docs arm is unreachable in this run, so this stays advisory.",
      "failure_scenario": "A later caller that checkpoints between an async forward launch and its host sync (e.g. a pipelined prefill) copies a half-written recurrent state; the restored session then decodes from corrupted state with no error.",
      "precision_class": "advisory"
     }
    },
    {
