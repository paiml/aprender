      "excerpt": "",
      "excerpt_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "disposition": "fixed in 4ca8f95cf on the PR branch: VERDICT.md, gx10.json notable, roadmap PMAT-964 and the impl receipt now carry the median 75.7 and the ratio 0.046x; every other VERDICT number was recomputed from the receipts' median fields (gx10/mini/intel bands printed and compared)",
      "agy_id": "gx10-c1-comparator-median",
      "baselineState": "new"
     }
    },
    {
     "ruleId": "PRREV-AGY",
     "level": "note",
