{
  "$schema": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/errata01/os/schemas/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "pmat"
        }
      },
      "results": [
        {
          "ruleId": "complexity_delta",
          "level": "note",
          "message": {
            "text": "pmat analyze complexity over base (dee8802d9a) and head copies of the 9 changed non-test .rs files under crates/. Three functions rise, all under 10: build_tool_calling_message 3->4 (cognitive 6->7), to_grammar 1->3 (0->5), extract_tool_parameters 3->5 (2->6). The test module added by the 2nd commit adds no function above the base. Values equal the 25f354a206 receipt for #4711."
          },
          "properties": {
            "grounding": "measured",
            "command": [
              "pmat",
              "analyze",
              "complexity",
              "--format",
              "json",
              "--path",
              "<base and head copies of the 9 changed non-test .rs files>"
            ],
            "exit_code": 0,
            "stdout_sha256": "f3a9202af50c7d04b3ae294fd02a3f3446625925112ef20381010ecf9b547597",
            "failure_scenario": "a later branch in extract_tool_parameters crosses cyclomatic 10",
            "precision_class": "advisory"
          }
        },
        {
          "ruleId": "tdg_delta",
          "level": "note",
          "message": {
            "text": "pmat analyze tdg over base and head copies of the same 9 files. No grade falls; chat_template_official.rs A -> A+ (94.45 -> 98.25); openai_handlers.rs stays A- (87.52 -> 86.35)."
          },
          "properties": {
            "grounding": "measured",
            "command": [
              "pmat",
              "analyze",
              "tdg",
              "--format",
              "json",
              "--path",
              "<base and head copies of the 9 changed non-test .rs files>"
            ],
            "exit_code": 0,
            "stdout_sha256": "bf5da174452f1319442deeec34962f972bb2fba7efc7e8545def426d27b8944b",
            "failure_scenario": "openai_handlers.rs drifts from A- to B+ as the file grows",
            "precision_class": "advisory"
          }
        },
        {
          "ruleId": "satd_none_introduced",
          "level": "note",
          "message": {
            "text": "pmat analyze satd reports 0 violations on both base and head copies; the report digest is identical, so the diff introduces no SATD marker."
          },
          "properties": {
            "grounding": "measured",
            "command": [
              "pmat",
              "analyze",
              "satd",
              "--format",
              "json",
              "--path",
              "<head copies of the 9 changed non-test .rs files>"
            ],
            "exit_code": 0,
            "stdout_sha256": "0f337997eb607f2a757f6c78182c5f1843f2dae49aa9a9dbe4fc8ddcbca088d5",
            "failure_scenario": "a TODO or FIXME added by the diff would be listed as a violation",
            "precision_class": "advisory"
          }
        },
        {
          "ruleId": "duplication_scan",
          "level": "note",
          "message": {
            "text": "scripts/pr_review_duplication_scan.sh swept 31 needles over HEAD, 1529 of 1529 sibling branches and the 6 merge-base-to-main files. 7 hits: 3 are the generic name args_of in aprender-contracts (not prior art); 4 are the filename PMAT-4650.yaml on origin branches of the SAME ticket (#4650 and the closed #4711, whose net change this PR rebuilds), which is expected lineage and not a second implementation."
          },
          "properties": {
            "grounding": "measured",
            "command": [
              "bash",
              "scripts/pr_review_duplication_scan.sh",
              "--base",
              "dee8802d9a",
              "--head",
              "06a71e72ad",
              "--rust-semantic",
              "--json",
              "<out>"
            ],
            "exit_code": 0,
            "stdout_sha256": "d006d329c42c57b01177f8a09252e5235b189e89ad6d0fd80ac7389679ae67cd",
            "failure_scenario": "a sibling branch implements the same tools-to-template path under a different name; the scan matches exact names only",
            "precision_class": "advisory"
          }
        },
        {
          "ruleId": "rebuilt_files_equal_closed_pr",
          "level": "note",
          "message": {
            "text": "All 15 files of c3061520d1 have a blob at 06a71e72ad~1 equal to the blob at 66a8f042a2 (the #4711 head): 15 of 15 same, 0 DIFF. So the prior #4711 review (25f354a206, DEGRADED, no blocking class) is the verdict on the same code. The 2nd commit changes only openai_handlers.rs, by appending the test module."
          },
          "properties": {
            "grounding": "measured",
            "command": [
              "bash",
              "-c",
              "for f in $(git diff --name-only c3061520d1~1 c3061520d1); do compare git rev-parse 06a71e72ad~1:$f with 66a8f042a2:$f; done"
            ],
            "exit_code": 0,
            "stdout_sha256": "085390fc07f5605ea3cf5dc98d02c36a2393b707fd9ec27166c0664df0e24417",
            "failure_scenario": "a file in the rebuilt commit that differs from the reviewed #4711 head carries code no prior review saw",
            "precision_class": "advisory"
          }
        },
        {
          "ruleId": "diff_patch_id_matches_ci",
          "level": "note",
          "message": {
            "text": "prpid_compute over dee8802d9a..06a71e72ad for PR 4866 returns ddeb684e1daac73dd18d4655a2c5c28b84cbdefc, the value CI present Arm 4 expects."
          },
          "properties": {
            "grounding": "measured",
            "command": [
              "bash",
              "-c",
              ". scripts/lib/pr_review_patch_id.sh; prpid_compute . dee8802d9a 06a71e72ad 4866"
            ],
            "exit_code": 0,
            "stdout_sha256": "9ccf7635c4144e91949a4433d2387d28da1a97b23b367315d1457b89cf9bde2a",
            "failure_scenario": "a receipt whose diff_patch_id differs from the recomputed one is refused by present",
            "precision_class": "advisory"
          }
        },
        {
          "ruleId": "new_test_discriminates_both_mutants",
          "level": "note",
          "message": {
            "text": "tokenize_chat_prompt_4711 (openai_handlers.rs:1847-1880) kills Ok(vec![0]) and Ok(vec![1]) on reading, with the length as the kill: the demo vocabulary is <unk> plus token1..token99 with no <0xNN> entries, so the rendered prompt encodes to a run of unk ids, and the guard want.len() >= 2 makes a one-id body unequal to want on length, while Ok(vec![1]) also differs on value. The author reports a mutant proof on another host (1 passed on the real body, rc 101 with the assert message under each mutant); this run did not execute it."
          },
          "properties": {
            "grounding": "asserted",
            "rationale": "read of tokenize_chat_prompt (openai_handlers.rs:84-102), AppState::demo (mod_app_state_new.rs:290-312) and BPETokenizer::encode/byte_fallback_id (tokenizer.rs:305-496); no cargo run on this host",
            "failure_scenario": "if the demo vocabulary ever gained a token for a prompt byte, want could shrink to one id and the length guard would fail the test loudly rather than pass vacuously",
            "precision_class": "advisory"
          }
        },
        {
          "ruleId": "new_test_is_hermetic",
          "level": "note",
          "message": {
            "text": "The test builds AppState::demo() in memory (no model file, no env var, no network, no clock) and calls two pure functions; with no GGUF mapped, the template path is the built-in one, so the result is deterministic on any host. The only side effect is an eprintln warning, and only when tools are given, which this test does not pass."
          },
          "properties": {
            "grounding": "asserted",
            "rationale": "read of the test and of format_chat_messages_for_state_thinking_tools (realize_handlers.rs:330-347)",
            "failure_scenario": "a host with a different default feature set could change AppState::demo; sibling tests use the same call, so a break would show there first",
            "precision_class": "advisory"
          }
        },
        {
          "ruleId": "new_test_oracle_is_length_not_content",
          "level": "warning",
          "message": {
            "text": "Because want is a run of the unk id, assert_eq!(got, want) proves the length and the unk value, not that the ids encode THIS prompt. A body that encoded a different string of equal length, or returned vec![0; N] for the right N, would pass. The two named mutants are killed; a wider family is not. A probe containing a vocabulary word (for example token5) would make want content-bearing."
          },
          "properties": {
            "grounding": "asserted",
            "rationale": "derived from the demo vocabulary and the byte_fallback_id fall-through to the unk id (openai_handlers.rs:1862-1880); not executed here",
            "failure_scenario": "a future change that drops the system or user turn from the rendered text but keeps its length would pass this test",
            "precision_class": "advisory"
          }
        }
      ]
    },
    {
      "tool": {
        "driver": {
          "name": "nvidia-cuda-docs"
        }
      },
      "invocations": [
        {
          "executionSuccessful": true,
          "toolExecutionNotifications": []
        }
      ],
      "results": []
    },
    {
      "tool": {
        "driver": {
          "name": "crux"
        }
      },
      "results": [
        {
          "ruleId": "crux_surface_covered",
          "level": "note",
          "message": {
            "text": "The diff changes the /v1/chat/completions request (tools reach the template) and response (message.tool_calls). contracts/crux-C-11-v1.yaml and contracts/crux-C-03-v1.yaml are present at head. gap_effect none."
          },
          "properties": {
            "grounding": "measured",
            "command": [
              "ls",
              "contracts/crux-C-11-v1.yaml",
              "contracts/crux-C-03-v1.yaml"
            ],
            "exit_code": 0,
            "stdout_sha256": "89602ee4d43dbf2334a2da7a2254260d0c94cdd4ae913d4f1f8626c6a902322f",
            "failure_scenario": "a surface with no covering contract would be crux_coverage none",
            "precision_class": "advisory"
          }
        }
      ]
    },
    {
      "tool": {
        "driver": {
          "name": "cargo-mutants"
        }
      },
      "invocations": [
        {
          "executionSuccessful": true,
          "toolExecutionNotifications": [
            {
              "level": "note",
              "message": {
                "text": "NOT re-run here: host policy runs cargo and cargo-mutants on another host only. The earlier figures (18 in-diff mutants, 11 caught, 7 missed at f2338256ee) are not carried as measured: they predate this base. The 2nd commit targets the survivors Ok(vec![0]) and Ok(vec![1]) in tokenize_chat_prompt; the author reports a mutant proof, which this run did not execute. grammar/tool.rs, chat_template_official.rs and mod_create_demo.rs are include!d and were never enumerated."
              }
            }
          ]
        }
      ],
      "results": [
        {
          "ruleId": "mutants_not_rerun",
          "level": "warning",
          "message": {
            "text": "No cargo test and no cargo-mutants ran in this review (host policy). The 4650 tests and the new test are therefore unexecuted by this reviewer; the other survivors recorded for #4711 (try_gpu_backend, try_cached_backend, a delete-! and two format_chat_messages_for_state_thinking replacements) are unconfirmed either way."
          },
          "properties": {
            "grounding": "asserted",
            "rationale": "host policy forbids cargo on this host; Rust mutation is advisory under the skill",
            "failure_scenario": "a surviving mutant in the tools-to-template path is a regression no test would catch",
            "precision_class": "advisory"
          }
        }
      ]
    },
    {
      "tool": {
        "driver": {
          "name": "antigravity"
        }
      },
      "invocations": [
        {
          "executionSuccessful": false,
          "toolExecutionNotifications": [
            {
              "level": "error",
              "message": {
                "text": "Consultation could not be performed. The disposable review tree step, git archive 06a71e72ad | tar -x, was refused by the lane hook subagent-lock.sh (a review lane runs read-only git only). agy itself resolves and runs (agy --version = 1.3.0, rc 0), but no review was attempted and the hook was not routed around. Verdict DEGRADED."
              },
              "properties": {
                "grounding": "measured",
                "command": [
                  "agy",
                  "--version"
                ],
                "exit_code": 0,
                "stdout_sha256": "64d23f858ef51b0f996e4966d4e27c0371b437e2d2787890b1f7ad22d4ec5663"
              }
            }
          ]
        }
      ],
      "results": []
    }
  ]
}
