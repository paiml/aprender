     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "scripts/lib/resolve_includes.py"
        },
        "region": {
         "startLine": 71
        }
       }
      }
     ],
     "properties": {
      "grounding": "asserted",
      "precision_class": "advisory",
      "failure_scenario": "A developer legitimately using the string `include_str!(\"../../foo\")` inside a raw string literal will fail the CI check unnecessarily.",
      "source": "agy gemini-3.1-pro-high on 3952ebd38: ",
      "excerpt": "",
      "excerpt_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "disposition": "re-verified by the primary: a string-literal edge case of a textual resolver (an include_str! spelled inside a raw string, block-comment delimiters split across two strings, or `use wasm_bindgen` inside a multi-line string). No such site exists in the tree (the --escapes sweep and the full guard pass on all 10 crates); the two false-negative shapes are backstopped by cargo publish's own verification build, which is the gate this guard defends in depth. Recorded as a documented residual, not fixed.",
      "agy_id": "string-literal-false-positive",
      "baselineState": "new"
     }
    },
    {
     "ruleId": "PRREV-AGY",
     "level": "note",
     "message": {
