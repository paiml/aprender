              "bash",
              "-c",
              "git grep -nE '\"(trueno|realizar|entrenar|batuta|pacha|alimentar)(/|\")' -- '*/Cargo.toml' | awk -F: '{line=$0; sub(/^[^:]*:[0-9]+:/,\"\",line); if (line ~ /^[[:space:]]*#/) c++; else if (line ~ /^[[:space:]]*name[[:space:]]*=/) n++; else f++} END{print \"feature_arrays=\" f \" name_keys=\" n \" comments=\" c}'"
