        {
          "ruleId": "preflight-row-overstates",
          "level": "warning",
          "message": {
            "text": "The preflight lane row keeps its release-day text \"check_publish_preflight.sh R1-R8\", but its new producer job runs check_publish_preflight.sh --graph-only (R2 + R6). The producer workflow header names the row text it expects: \"check_publish_preflight.sh --graph-only (R6; R1/R3/R4 at publish)\". A green preflight lane therefore reads as R1-R8 in the bundle while only two rules ran."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "scripts/release/nightly_train.sh"
                },
                "region": {
                  "startLine": 83
                }
              }
            }
          ],
          "properties": {
            "grounding": "asserted",
            "rationale": "Read the row against the producer job step in release-gates-nightly.yml and that file's own header comment; the two texts differ and the PR's byte-pin test pins the longer one.",
            "failure_scenario": "A reader of bundle.tsv sees preflight green with the check text R1-R8 and takes R1, R3, R4, R5, R7 and R8 as measured by that lane, though only R2 and R6 were run. Other lanes cover R5, R7 and R8; R1, R3 and R4 are not run before publish. The train is report-only, so nothing is blocked.",
            "precision_class": "advisory"
          }
        },
        {
          "ruleId": "nodefault-tolerates-3176",
          "level": "note",
          "message": {
            "text": "The deep-nodefault producer job exits 0 when every cargo check --no-default-features error lies inside crates/aprender-distribute (the standing #3176 class), while the lane row text says plain \"cargo check --workspace --no-default-features\". The lane is green with a known standing red hidden in it."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/deep-nightly.yml"
                },
                "region": {
                  "startLine": 69
                }
              }
            }
          ],
          "properties": {
            "grounding": "asserted",
            "rationale": "Read the job step: the exit test counts only errors outside aprender-distribute and ignores the cargo exit code.",
            "failure_scenario": "The #3176 class grows or stays, the lane stays green, and the bundle never shows it. The tolerance is in the producer that already exists on main, not in this diff, so this PR widens nothing; it only starts to read that job as a verdict.",
            "precision_class": "advisory"
          }
        }
      ]
