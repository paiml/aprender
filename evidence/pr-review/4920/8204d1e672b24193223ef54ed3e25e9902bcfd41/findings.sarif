        {
          "ruleId": "agy-nightly-assert-fail",
          "level": "note",
          "message": {
            "text": "The `assert_pinned_no_sync` proof fails when the pinned channel is a dated nightly because it checks if `rustc --version` starts with `rustc $ch ` (e.g. `rustc nightly-2026-01-02 `) but rustc actually outputs `rustc 1.X.X-nightly `."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "scripts/ci/pinned_rustup_home.sh"
                },
                "region": {
                  "startLine": 157
                }
              }
            }
          ],
          "properties": {
            "grounding": "measured",
            "precision_class": "advisory",
            "failure_scenario": "If a developer updates `rust-toolchain.toml` to pin a dated nightly (which `read_pin` explicitly allows via `^nightly-[0-9]{4}-[0-9]{2}-[0-9]{2}$`), the `seed` step will successfully install it but then immediately fail the job during the proof step because the regex fails to match the real output of `rustc +nightly --version`.",
            "measured_by": "agy",
            "command": [
              "bash",
              "-c",
              "out=\"rustc 1.97.0-nightly (0febdbab2 2026-04-18)\"; ch=\"nightly-2026-01-02\"; grep -q \"^rustc ${ch//./\\.} \" <<< \"$out\" || echo FAIL"
            ],
            "note": "agy returned the command but no exit code or stdout digest; reverified_by_primary is false"
          }
        }
      ]
    }
