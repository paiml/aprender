    {
      "tool": {
        "driver": {
          "name": "antigravity",
          "version": "1.3.1"
        }
      },
      "invocations": [
        {
          "executionSuccessful": true,
          "toolExecutionNotifications": []
        }
      ],
      "results": [
        {
          "ruleId": "agy-refuse-legitimate-list-with-comment",
          "level": "note",
          "message": {
            "text": "Awk script incorrectly refuses a legitimate flow sequence with a trailing comment."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "scripts/lib/release_policy_block.awk"
                },
                "region": {
                  "startLine": 22
                }
              }
            }
          ],
          "properties": {
            "grounding": "measured",
            "precision_class": "advisory",
            "failure_scenario": "If a flow sequence with a trailing comment (like the one present in contracts/model-capability-ladder-v1.yaml: `hosts: [lambda]   # gx10 DE-CLAIMED...`) is placed in the release_policy block, the script refuses it because it starts with `[` and contains ` #`. The script incorrectly instructs the user to 'quote the value', which would change the YAML type from a list to a string.",
            "command": [
              "awk",
              "-v",
              "keys=hosts",
              "-f",
              "scripts/lib/release_policy_block.awk",
              "test-finding-4.yaml"
            ],
            "measured_by": "agy",
            "note": "agy returned the command but no exit code or stdout digest; reverified_by_primary is false"
          }
        },
        {
          "ruleId": "agy-miss-tab-before-hash",
          "level": "note",
          "message": {
            "text": "Awk script misses a YAML comment that is preceded by a tab instead of a space."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "scripts/lib/release_policy_block.awk"
                },
                "region": {
                  "startLine": 22
                }
              }
            }
          ],
          "properties": {
            "grounding": "measured",
            "precision_class": "advisory",
            "failure_scenario": "If a user uses a tab to separate a comment (`ticket_owner: 3598\\t# comment`), the `index(val, \" #\")` check returns 0 because it strictly looks for a space-hash. The script misses the comment and includes the comment string inside the parsed value, disagreeing with the YAML parser.",
            "command": [
              "awk",
              "-v",
              "keys=ticket_owner",
              "-f",
              "scripts/lib/release_policy_block.awk",
              "test-finding-2.yaml"
            ],
            "measured_by": "agy",
            "note": "agy returned the command but no exit code or stdout digest; reverified_by_primary is false"
          }
        },
        {
          "ruleId": "agy-miss-comment-after-quoted-value",
          "level": "note",
          "message": {
            "text": "Awk script misses a trailing YAML comment after a double-quoted value."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "scripts/lib/release_policy_block.awk"
                },
                "region": {
                  "startLine": 22
                }
              }
            }
          ],
          "properties": {
            "grounding": "measured",
            "precision_class": "advisory",
            "failure_scenario": "If a trailing comment is added after a double-quoted string (`name: \"crux-smoke\" # comment`), `substr(val, 1, 1)` is `\"`. This causes the condition `substr(val, 1, 1) != \"\\\"\"` to be false, short-circuiting the space-hash check. The script misses the comment and includes it in the parsed value, disagreeing with the YAML parser.",
            "command": [
              "awk",
              "-v",
              "keys=name",
              "-f",
              "scripts/lib/release_policy_block.awk",
              "test-finding-3.yaml"
            ],
            "measured_by": "agy",
            "note": "agy returned the command but no exit code or stdout digest; reverified_by_primary is false"
          }
        }
      ]
    }
