  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "pmat",
          "version": "3.42.0"
        }
      },
      "invocations": [
        {
          "executionSuccessful": true,
          "toolExecutionNotifications": []
        }
      ],
      "results": [
        {
          "ruleId": "awk-tab-before-hash-missed",
          "level": "note",
          "message": {
            "text": "A tab before # is a YAML comment, but index(val, \" #\") looks only for a space. 'ticket_owner: bob<TAB># c' exits 0 and the reader keeps the raw value 'bob<TAB># c'. The new rule's stated aim (reader and YAML parser never disagree) is not met for this form; the self-test has no tab row."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "scripts/lib/release_policy_block.awk"
                },
                "region": {
                  "startLine": 22
                }
              }
            }
          ],
          "properties": {
            "grounding": "measured",
            "failure_scenario": "A policy line 'hosts: [lambda]<TAB># gx10 off' is accepted; the raw value with the comment is copied into the synthesized emergency_scopes entry. ticket_owner and since are re-validated downstream and still fail closed, so impact is limited to hosts, thinking, quote, date, name.",
            "precision_class": "advisory",
            "command": [
              "awk",
              "-v",
              "keys=name since date quote hosts thinking larger_rows red_row_needs ticket_owner release_notes",
              "-f",
              "scripts/lib/release_policy_block.awk",
              "/tmp/claude-1000/-mnt-nvme-raid0-la-71/7705b2a4-f00a-4190-9eb8-5feffc6cba66/scratchpad/tab.yaml"
            ],
            "exit_code": 0,
            "stdout_sha256": "40f969c8aefe83d139fce0ea284e14fa96a96ee96a05009782be7e8ada469d18"
          }
        },
        {
          "ruleId": "awk-comment-after-double-quoted-missed",
          "level": "note",
          "message": {
            "text": "A double-quoted value skips the whole check, so a comment after the closing quote is not refused: 'ticket_owner: \"bob\" # c' exits 0 with the raw value '\"bob\" # c'. The # is only meaningful outside the quotes, which the rule does not look at."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "scripts/lib/release_policy_block.awk"
                },
                "region": {
                  "startLine": 22
                }
              }
            }
          ],
          "properties": {
            "grounding": "measured",
            "failure_scenario": "A policy author writes 'quote: \"...\" # note'. The awk accepts it and the raw text, comment included, is copied into the entry; rp_unq then fails to strip quotes on since/ticket_owner (fails closed, rc 2) but date/quote/hosts pass through unvalidated.",
            "precision_class": "advisory",
            "command": [
              "awk",
              "-v",
              "keys=name since date quote hosts thinking larger_rows red_row_needs ticket_owner release_notes",
              "-f",
              "scripts/lib/release_policy_block.awk",
              "/tmp/claude-1000/-mnt-nvme-raid0-la-71/7705b2a4-f00a-4190-9eb8-5feffc6cba66/scratchpad/dq.yaml"
            ],
            "exit_code": 0,
            "stdout_sha256": "b815054043346abccae9953080783534531dfebb6b2763f040f6792f0efd9a96"
          }
        },
        {
          "ruleId": "awk-single-quoted-hash-refused",
          "level": "note",
          "message": {
            "text": "A single-quoted value is scanned for ' #' while a double-quoted one is exempt, so the two YAML quote styles are treated differently. A legitimate single-quoted value such as 'see #5' is refused with 'quote the value', advice that cannot be followed. The real release_policy block (contracts/model-capability-ladder-v1.yaml lines 102-112) has no ' #' in any value, and the real-* rows pass, so nothing real is refused today."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "scripts/lib/release_policy_block.awk"
                },
                "region": {
                  "startLine": 22
                }
              }
            }
          ],
          "properties": {
            "grounding": "measured",
            "failure_scenario": "A maintainer edits the single-quoted quote: line (it is single-quoted because it holds double quotes) to cite 'ticket #3598'. The ladder is then unreadable (rc 2) until the text is reworded, with a misleading hint.",
            "precision_class": "advisory",
            "command": [
              "awk",
              "-v",
              "keys=name since date quote hosts thinking larger_rows red_row_needs ticket_owner release_notes",
              "-f",
              "scripts/lib/release_policy_block.awk",
              "/tmp/claude-1000/-mnt-nvme-raid0-la-71/7705b2a4-f00a-4190-9eb8-5feffc6cba66/scratchpad/sq.yaml"
            ],
            "exit_code": 2,
            "stdout_sha256": "b84ee7eefa935d0e7da5f3bc795bd9c79ab414fa4048fb718d5e2fbd40779a36"
          }
        },
        {
          "ruleId": "unrelated-change-bundled",
          "level": "note",
          "message": {
            "text": "The PR adds a models_nightly --self-test row (tickets_unset_green_rung_is_red) that has nothing to do with the release_policy # rule or its title. It passes (84/84) and is not wrong; it is scope that a reviewer of the awk change will not expect."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "scripts/release/models_nightly.sh"
                },
                "region": {
                  "startLine": 604
                }
              }
            }
          ],
          "properties": {
            "grounding": "asserted",
            "failure_scenario": "None at run time; a revert of the awk change would leave an unrelated row in the diff history.",
            "precision_class": "advisory",
            "rationale": "The PR adds a models_nightly --self-test row (tickets_unset_green_rung_is_red) that has nothing to do with the release_policy # rule or its title. It passes (84/84) and is not wrong; it is scope that a reviewer of the awk change will not expect."
          }
        }
      ]
    },
