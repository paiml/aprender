{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "pmat",
          "version": "3.42.0"
        }
      },
      "invocations": [
        {
          "executionSuccessful": false,
          "toolExecutionNotifications": [
            {
              "level": "error",
              "message": {
                "text": "antigravity unreachable: agy 1.3.1 headless run auto-denied the \"command\" permission (denied_actions RunCommand, response empty); no review was produced. The --dangerously-skip-permissions bypass was not used."
              }
            }
          ]
        }
      ],
      "results": [
        {
          "ruleId": "conservative-refusal-escaped-quotes",
          "level": "note",
          "message": {
            "text": "A quoted value holding its own quote character (\"a\\\"b\", 'it''s') is still refused, by design. The error text now says so (no \\\" or doubled-quote escapes), so the refusal is explained, not silent. The real release_policy block has no such value."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "scripts/lib/release_policy_block.awk"
                },
                "region": {
                  "startLine": 25
                }
              }
            }
          ],
          "properties": {
            "grounding": "measured",
            "failure_scenario": "A future policy value needing an embedded quote is refused with a clear message and must be reworded; fail closed, no wrong value reaches the YAML parser.",
            "precision_class": "advisory",
            "command": [
              "bash",
              "scripts/check_release_policy_selftest.sh"
            ]
          }
        }
      ]
    },
    {
      "tool": {
        "driver": {
          "name": "cargo-mutants",
          "version": "bash-sed-mutants"
        }
      },
      "invocations": [
        {
          "executionSuccessful": true,
          "toolExecutionNotifications": []
        }
      ],
      "results": []
    },
    {
      "tool": {
        "driver": {
          "name": "antigravity",
          "version": "1.3.1"
        }
      },
      "invocations": [
        {
          "executionSuccessful": true,
          "toolExecutionNotifications": []
        }
      ],
      "results": [
        {
          "ruleId": "agy-legitimate-values",
          "level": "note",
          "message": {
            "text": "The awk rule accepts all existing legitimate values in the model-capability-ladder-v1.yaml release_policy block without error."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "scripts/lib/release_policy_block.awk"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ],
          "properties": {
            "grounding": "measured",
            "precision_class": "advisory",
            "failure_scenario": "If the rule incorrectly refused a legitimate value (such as the single-quoted `quote` containing double quotes, or the `thinking: [\"off\", \"on\"]` list which contains spaces), it would falsely fail the CI gate and block valid policies.",
            "command": [
              "awk",
              "-v",
              "keys=name since date quote hosts thinking larger_rows red_row_needs ticket_owner release_notes",
              "-f",
              "scripts/lib/release_policy_block.awk",
              "contracts/model-capability-ladder-v1.yaml"
            ],
            "measured_by": "agy",
            "note": "agy returned the command but no exit code or stdout digest; reverified_by_primary is false"
          }
        },
        {
          "ruleId": "agy-yaml-comments",
          "level": "note",
          "message": {
            "text": "The rule strictly rejects all YAML comment forms. Unquoted comments are caught by `/[ \\\\t]#/`, and comments trailing a quoted value are caught by the closing quote validation."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "scripts/lib/release_policy_block.awk"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ],
          "properties": {
            "grounding": "asserted",
            "precision_class": "advisory",
            "failure_scenario": "If the awk script accepted a YAML comment form, it would extract the comment as part of the string value while a standard YAML parser would ignore it. This divergence would allow policies to pass the gate under one interpretation but run in production under another.",
            "rationale": "The rule strictly rejects all YAML comment forms. Unquoted comments are caught by `/[ \\\\t]#/`, and comments trailing a quoted value are caught by the closing quote validation."
          }
        },
        {
          "ruleId": "agy-mutant-killing",
          "level": "note",
          "message": {
            "text": "The new self-test rows successfully kill mutants of the awk rule, catching regressions such as dropping tab-hash support or single-quote validation."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "scripts/check_release_policy_selftest.sh"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ],
          "properties": {
            "grounding": "measured",
            "precision_class": "advisory",
            "failure_scenario": "If the self-tests were vacuous, a developer could remove `\\t` from the space-hash regex, drop support for single quotes, or drop the strict closing quote check, and the tests would still pass, permitting unquoted hashes or trailing junk to bypass the policy reader.",
            "command": [
              "bash",
              "-c",
              "sed -i 's/\\[ \\\\t\\]#/ #/' scripts/lib/release_policy_block.awk && bash scripts/check_release_policy_selftest.sh"
            ],
            "measured_by": "agy",
            "note": "agy returned the command but no exit code or stdout digest; reverified_by_primary is false"
          }
        }
      ]
    }
  ]
}
