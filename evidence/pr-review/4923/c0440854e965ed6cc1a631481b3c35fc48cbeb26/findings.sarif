              }
            }
          ],
          "properties": {
            "grounding": "asserted",
            "failure_scenario": "none",
            "precision_class": "advisory",
            "rationale": "The three earlier findings are fixed and measured: tab before # now refused, a comment after a double or single closing quote refused, and 'see #5' kept. Real block still accepted (real-* rows pass); 64 rows 0 failed; models_nightly self-test 84/84."
          }
        }
