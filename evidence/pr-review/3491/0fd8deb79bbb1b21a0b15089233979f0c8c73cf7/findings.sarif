            "exit_code": 0,
            "stdout_sha256": "04f5f15ed7b12020c29e692624410ba88908054adcb33b4aeefd0eb424847479",
            "precision_class": "advisory",
            "corroborating_commands": [
              [
                "pmat",
                "query",
                "x",
                "--rebuild-index",
                "--limit",
                "1"
              ],
              [
                "stat",
