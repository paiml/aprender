{
  "$schema": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/errata01/os/schemas/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "pmat"
        }
      },
      "invocations": [
        {
          "executionSuccessful": true,
          "toolExecutionNotifications": []
        }
      ],
      "results": [
        {
          "ruleId": "no_reusable_prior_art",
          "level": "note",
          "message": {
            "text": "The delta adds a concurrency group, a head_branch and head_repository filter and a reworded body; pmat query over the head-built index found no reusable issue opener, and the duplication scan reached all branches without a new hit."
          },
          "properties": {
            "grounding": "measured",
            "rationale": "Index built at head in this worktree; the duplication scan covers 1560/1560 branches.",
            "failure_scenario": "A reusable opener would leave a drifting second copy; none was found.",
            "precision_class": "advisory",
            "command": [
              "pmat",
              "query",
              "release ticket issue create nightly",
              "--limit",
              "5",
              "--format",
              "json"
            ],
            "exit_code": 0,
            "stdout_sha256": "c6d8c19f7d527c5eaf72bd894745c42a3cd042016f5e54fcd4b60298ebbf9152"
          }
        },
        {
          "ruleId": "no_satd_introduced",
          "level": "note",
          "message": {
            "text": "The delta adds 0 TODO, FIXME, HACK or XXX markers."
          },
          "properties": {
            "grounding": "measured",
            "rationale": "Added lines only; grep -c exits 1 on zero.",
            "failure_scenario": "A new debt marker would ship without a ticket; there is none.",
            "precision_class": "advisory",
            "command": [
              "sh",
              "-c",
              "git diff 85b2d6dace 6b6906992591965d10dc0e8ecdeb7d62041c3e11 -- scripts .github | grep -E '^[+]' | grep -v '^[+][+][+]' | grep -ciE 'TODO|FIXME|HACK|XXX'"
            ],
            "exit_code": 1,
            "stdout_sha256": "9a271f2a916b0b6ee6cecb2426f0b3206ef074578be55d9bc94f6f3fe3ab86aa"
          }
        },
        {
          "ruleId": "prior_findings_closed",
          "level": "note",
          "message": {
            "text": "The earlier branch-filter and concurrency findings are closed in the delta: the job if: now requires head_branch == 'main' and the same repository, and the workflow has a concurrency group with cancel-in-progress false. The self-test reads 116 pass, 0 fail with the policy library, and the green-night finding is answered by the reworded body (a green night does not close the ticket; its owner does)."
          },
          "properties": {
            "grounding": "measured",
            "rationale": "The command path is abbreviated in this record; the recorded exit code is tail's; the figure is in the last line: 116 pass, 0 fail. The file greps found the concurrency key (1) and the head_branch filter (1).",
            "failure_scenario": "If the filter or the group were missing, a feature-branch dispatch or two overlapping nights would write the ticket wrongly; both are present.",
            "precision_class": "advisory",
            "command": [
              "sh",
              "-c",
              "ASSETS_REHEARSAL_POLICY_LIB=<release_policy.sh from the policy PR 4910 worktree> bash scripts/release/assets_rehearsal.sh --self-test | tail -n 1"
            ],
            "exit_code": 0,
            "stdout_sha256": "5502a31a687ced4948ea40ce0d71a5c6cb2d668a5c0135f1f4c2075376a51b99"
          }
        },
        {
          "ruleId": "pending_run_replaced_by_later_night",
          "level": "note",
          "message": {
            "text": "GitHub keeps one pending run per concurrency group and cancels an older pending one, and the group is entered by every completed rehearsal, including green ones whose job the if: skips. A red night waiting behind a running ticket job can therefore be replaced by a later green night's skipped run and never write its comment. The workflow comment states the replacement only for a third night; the ticket still gets the next red night."
          },
          "properties": {
            "grounding": "asserted",
            "rationale": "Reasoning from documented concurrency semantics, not an executed repro; the effect is one lost comment on an already open ticket.",
            "failure_scenario": "A red night's commit is never named on the ticket when a green night's run replaces it while it waits; the ticket stays open and the next red night updates it.",
            "precision_class": "advisory"
          }
        }
      ]
    },
    {
      "tool": {
        "driver": {
          "name": "antigravity"
        }
      },
      "invocations": [
        {
          "executionSuccessful": true,
          "toolExecutionNotifications": []
        }
      ],
      "results": [
        {
          "ruleId": "workflow_run_redundant_repository_filter",
          "level": "warning",
          "message": {
            "text": "agy (gemini-3.1-pro-high): The `head_repository.full_name == github.repository` check in the job's `if:` condition is redundant."
          },
          "properties": {
            "grounding": "asserted",
            "rationale": "agy reviewer judgement. The primary disagrees: workflow_run also fires for runs from forks, whose head_repository.full_name differs, so the repository check is not redundant; readiness-nightly.yml uses the same pair.",
            "failure_scenario": "The check adds unnecessary logic to the `if` condition without providing any actual filtering, because GitHub Actions strictly limits `workflow_run` events to only trigger for workflows executing within the exact same repository.",
            "precision_class": "advisory"
          }
        },
        {
          "ruleId": "workflow_run_job_level_branch_filter_ux",
          "level": "warning",
          "message": {
            "text": "agy (gemini-3.1-pro-high): Filtering for the `main` branch inside the job's `if:` block creates UI noise by generating skipped workflow runs."
          },
          "properties": {
            "grounding": "asserted",
            "rationale": "agy reviewer judgement",
            "failure_scenario": "When a developer manually dispatches the nightly rehearsal on a feature branch, a skipped `Assets rehearsal tickets` workflow run will still be created and clutter the Actions history. Implementing the branch filter directly on the event trigger (`on: workflow_run: branches: [main]`) would completely prevent these unnecessary runs from being queued.",
            "precision_class": "advisory"
          }
        }
      ]
    }
  ]
}
