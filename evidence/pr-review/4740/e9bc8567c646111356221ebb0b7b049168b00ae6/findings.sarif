          "message": {
            "text": "bash scripts/check_quick_tier_shard_sigma.sh at head e9bc8567c6: rc 0, 26 ok rows, 0 FAIL, PASS. The allowlist does not false-RED the real tree."
          },
          "properties": {
            "grounding": "measured",
            "command": [
              "bash",
              "scripts/check_quick_tier_shard_sigma.sh"
            ],
