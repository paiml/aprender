@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ont: <https://ont.paiml.dev/v1alpha1/> .

<https://ont.paiml.dev/v1alpha1/shape/bound-symbols-resolve> a sh:NodeShape ;
    sh:targetClass <https://ont.paiml.dev/v1alpha1/Symbol> ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/sym/crate> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/sym/module> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/sym/name> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/sym/implements> ;
        sh:minCount 1 ;
        sh:class <https://ont.paiml.dev/v1alpha1/Contract> ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/sym/resolved> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) ;
    ] ;
.

<https://ont.paiml.dev/v1alpha1/shape/lean-statements-grounded> a sh:NodeShape ;
    sh:targetClass <https://ont.paiml.dev/v1alpha1/Statement> ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/lean/name> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/lean/file> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/lean/discharge> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "grounded" "admitted" ) ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/lean/sorryFree> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) ;
    ] ;
.

<https://ont.paiml.dev/v1alpha1/shape/ladder-measured> a sh:NodeShape ;
    sh:targetClass <https://ont.paiml.dev/v1alpha1/model/Model> ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/model/sha256> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:pattern "^[0-9a-f]{64}$" ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/model/parityReceipt> ;
        sh:minCount 1 ;
        sh:class <https://ont.paiml.dev/v1alpha1/model/Receipt> ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/model/receiptHexMismatch> ;
        sh:maxCount 0 ;
    ] ;
.

<https://ont.paiml.dev/v1alpha1/shape/ladder-green> a sh:NodeShape ;
    sh:targetClass <https://ont.paiml.dev/v1alpha1/model/RequiredModel> ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/model/missingGreenHost> ;
        sh:maxCount 0 ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/model/parityReceipt> ;
        sh:node <https://ont.paiml.dev/v1alpha1/shape/ladder-green/node> ;
    ] ;
.

<https://ont.paiml.dev/v1alpha1/shape/ladder-green/node> a sh:NodeShape ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/model/cc> ;
        sh:in ( "8.9" "12.1" ) ;
    ] ;
.

<https://ont.paiml.dev/v1alpha1/shape/ont-shapes-v1> a sh:NodeShape ;
    sh:targetClass <https://ont.paiml.dev/v1alpha1/Contract> ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/id> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:pattern "^[A-Za-z0-9._-]+$" ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/kind> ;
        sh:in ( "schema" "pattern" "kaizen" "kernel" "model-family" "beat-benchmark" "training-loop" "registry" "pretraining-corpus" "training-precondition-gate" "tokenizer" "model-family-variant" "corpus-assembly" ) ;
    ] ;
.

<https://ont.paiml.dev/v1alpha1/shape/parity-receipt-complete> a sh:NodeShape ;
    sh:targetClass <https://ont.paiml.dev/v1alpha1/parity/ParityReceipt> ;
    sh:closed true ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/parity/file> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/parity/host> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/parity/backend> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "cpu" "cuda" "wgpu" "metal" ) ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/parity/aprVersion> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/parity/generatedAt> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/parity/unmeasured> ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/parity/partiallyReceipted> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype <http://www.w3.org/2001/XMLSchema#boolean> ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/parity/thresholdSource> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/parity/thresholdSourceMissing> ;
        sh:maxCount 0 ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/parity/modelSha256> ;
        sh:maxCount 1 ;
        sh:pattern "^[0-9a-f]{64}$" ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/parity/comparator> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class <https://ont.paiml.dev/v1alpha1/parity/Comparator> ;
        sh:nodeKind sh:IRI ;
        sh:node <https://ont.paiml.dev/v1alpha1/shape/parity-receipt-complete/node> ;
    ] ;
.

<https://ont.paiml.dev/v1alpha1/shape/parity-receipt-complete/node> a sh:NodeShape ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/parity/kind> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "llama_cpp" "transformers" "self" ) ;
    ] ;
.

<https://ont.paiml.dev/v1alpha1/shape/parity-comparator-self> a sh:NodeShape ;
    sh:targetClass <https://ont.paiml.dev/v1alpha1/parity/SelfComparedReceipt> ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/parity/comparator> ;
        sh:node <https://ont.paiml.dev/v1alpha1/shape/parity-comparator-self/node> ;
    ] ;
.

<https://ont.paiml.dev/v1alpha1/shape/parity-comparator-self/node> a sh:NodeShape ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/parity/reason> ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/parity/comparatorSha> ;
        sh:maxCount 0 ;
    ] ;
.

<https://ont.paiml.dev/v1alpha1/shape/parity-comparator-oracle> a sh:NodeShape ;
    sh:targetClass <https://ont.paiml.dev/v1alpha1/parity/OracleComparedReceipt> ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/parity/comparator> ;
        sh:node <https://ont.paiml.dev/v1alpha1/shape/parity-comparator-oracle/node> ;
    ] ;
.

<https://ont.paiml.dev/v1alpha1/shape/parity-comparator-oracle/node> a sh:NodeShape ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/parity/comparatorSha> ;
        sh:minCount 1 ;
    ] ;
.

<https://ont.paiml.dev/v1alpha1/shape/refusal-receipt-v1> a sh:NodeShape ;
    sh:targetClass <https://ont.paiml.dev/v1alpha1/refusal/Refusal> ;
    sh:closed true ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/refusal/verb> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype <http://www.w3.org/2001/XMLSchema#string> ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/refusal/reason> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype <http://www.w3.org/2001/XMLSchema#string> ;
        sh:minLength 12 ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/refusal/exit_code> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype <http://www.w3.org/2001/XMLSchema#integer> ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/refusal/removed_by> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:pattern "^(v[0-9]+\\.[0-9]+|never|unscheduled)$" ;
    ] ;
.

<https://ont.paiml.dev/v1alpha1/shape/release-readiness-v1.release> a sh:NodeShape ;
    sh:targetClass <https://ont.paiml.dev/v1alpha1/release/Release> ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/release/requiredHost> ;
        sh:minCount 1 ;
        sh:class <https://ont.paiml.dev/v1alpha1/release/Host> ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/release/contextRung> ;
        sh:minCount 1 ;
        sh:class <https://ont.paiml.dev/v1alpha1/release/ContextRung> ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/release/dogfoodReceipt> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:node <https://ont.paiml.dev/v1alpha1/shape/release-readiness-v1.release/node> ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/release/surface> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class <https://ont.paiml.dev/v1alpha1/cli/Surface> ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/release/generatesUndeclared> ;
        sh:maxCount 0 ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/release/ratchetGrew> ;
        sh:maxCount 0 ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/release/ratchetBaselineMissing> ;
        sh:maxCount 0 ;
    ] ;
.

<https://ont.paiml.dev/v1alpha1/shape/release-readiness-v1.release/node> a sh:NodeShape ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/release/verdict> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "GO" ) ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/release/fresh> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) ;
    ] ;
.

<https://ont.paiml.dev/v1alpha1/shape/release-readiness-v1.host> a sh:NodeShape ;
    sh:targetClass <https://ont.paiml.dev/v1alpha1/release/Host> ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/release/hostReceipt> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:node <https://ont.paiml.dev/v1alpha1/shape/release-readiness-v1.host/node> ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/release/holds> ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/release/unmeasuredModel> ;
        sh:maxCount 0 ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/release/unkeyedRow> ;
        sh:maxCount 0 ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/release/kernelReceipt> ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:node <https://ont.paiml.dev/v1alpha1/shape/release-readiness-v1.host/node> ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/release/dispatchKernel> ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/release/modelWithoutDispatch> ;
        sh:maxCount 0 ;
    ] ;
.

<https://ont.paiml.dev/v1alpha1/shape/release-readiness-v1.host/node> a sh:NodeShape ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/release/schema> ;
        sh:minCount 1 ;
        sh:in ( "apr-model-ladder-receipt/v2" ) ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/release/fresh> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) ;
    ] ;
.

<https://ont.paiml.dev/v1alpha1/shape/release-readiness-v1.host/node> a sh:NodeShape ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/release/fresh> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) ;
    ] ;
.

<https://ont.paiml.dev/v1alpha1/shape/release-readiness-v1.context> a sh:NodeShape ;
    sh:targetClass <https://ont.paiml.dev/v1alpha1/release/ContextRung> ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/release/tokens> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/release/derivedFrom> ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/release/unmeasuredConsumer> ;
        sh:maxCount 0 ;
    ] ;
.

<https://ont.paiml.dev/v1alpha1/shape/release-readiness-v1.model> a sh:NodeShape ;
    sh:targetClass <https://ont.paiml.dev/v1alpha1/release/Model> ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/release/contextLength> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/release/arch> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/release/thinkingContradiction> ;
        sh:maxCount 0 ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/release/longRungsMismatch> ;
        sh:maxCount 0 ;
    ] ;
.

<https://ont.paiml.dev/v1alpha1/shape/release-readiness-v1.coverage> a sh:NodeShape ;
    sh:targetClass <https://ont.paiml.dev/v1alpha1/release/RungCoverage> ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/release/owedOn> ;
        sh:minCount 1 ;
        sh:class <https://ont.paiml.dev/v1alpha1/release/Host> ;
        sh:nodeKind sh:IRI ;
    ] ;
.

<https://ont.paiml.dev/v1alpha1/shape/release-readiness-v1.tokenizer> a sh:NodeShape ;
    sh:targetClass <https://ont.paiml.dev/v1alpha1/release/TokenizerCell> ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/release/row> ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:node <https://ont.paiml.dev/v1alpha1/shape/release-readiness-v1.tokenizer/node> ;
    ] ;
.

<https://ont.paiml.dev/v1alpha1/shape/release-readiness-v1.tokenizer/node> a sh:NodeShape ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/release/verdict> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "pass" ) ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/release/parityExact> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/release/roundTrip> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/release/corpusSha> ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/release/comparatorSha> ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/release/fresh> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) ;
    ] ;
.

<https://ont.paiml.dev/v1alpha1/shape/release-readiness-v1.kernel> a sh:NodeShape ;
    sh:targetClass <https://ont.paiml.dev/v1alpha1/release/KernelCell> ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/release/row> ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:node <https://ont.paiml.dev/v1alpha1/shape/release-readiness-v1.kernel/node> ;
    ] ;
.

<https://ont.paiml.dev/v1alpha1/shape/release-readiness-v1.kernel/node> a sh:NodeShape ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/release/verdict> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "pass" ) ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/release/withinBound> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/release/boundSource> ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/release/fresh> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) ;
    ] ;
.

<https://ont.paiml.dev/v1alpha1/shape/release-readiness-v1.crux-verb> a sh:NodeShape ;
    sh:targetClass <https://ont.paiml.dev/v1alpha1/release/CruxVerb> ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/release/mappingEntry> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/release/engineMissing> ;
        sh:maxCount 0 ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/release/noneWithoutReason> ;
        sh:maxCount 0 ;
    ] ;
.

<https://ont.paiml.dev/v1alpha1/shape/release-readiness-v1.crux> a sh:NodeShape ;
    sh:targetClass <https://ont.paiml.dev/v1alpha1/release/CruxObligation> ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/release/modeMissing> ;
        sh:maxCount 0 ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/release/cruxCell> ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:node <https://ont.paiml.dev/v1alpha1/shape/release-readiness-v1.crux/node> ;
    ] ;
.

<https://ont.paiml.dev/v1alpha1/shape/release-readiness-v1.crux/node> a sh:NodeShape ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/release/verdict> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "GREEN" "ALL_WRONG" ) ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/release/fresh> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) ;
    ] ;
.

<https://ont.paiml.dev/v1alpha1/shape/release-readiness-v1.effect> a sh:NodeShape ;
    sh:targetClass <https://ont.paiml.dev/v1alpha1/release/ModeEffect> ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/release/observedIn> ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
    ] ;
.

<https://ont.paiml.dev/v1alpha1/shape/release-readiness-v1.sampling> a sh:NodeShape ;
    sh:targetClass <https://ont.paiml.dev/v1alpha1/release/SamplingCheck> ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/release/sampledDiffers> ;
        sh:maxCount 1 ;
        sh:in ( "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/release/seedRepeatable> ;
        sh:maxCount 1 ;
        sh:in ( "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) ;
    ] ;
    sh:property [
        sh:path <https://ont.paiml.dev/v1alpha1/release/seedsDiffer> ;
        sh:maxCount 1 ;
        sh:in ( "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ) ;
    ] ;
    sh:property [
