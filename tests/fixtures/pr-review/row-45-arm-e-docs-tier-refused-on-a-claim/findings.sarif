{
  "$schema": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/errata01/os/schemas/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "crux"
        }
      },
      "invocations": [
        {
          "executionSuccessful": true,
          "toolExecutionNotifications": []
        }
      ],
      "results": [
        {
          "ruleId": "comparative_claim",
          "level": "note",
          "message": {
            "text": "book/src/tools/apr-cli.md publishes 2.93x Ollama; the comparator command, version, environment and artifact hash are recorded."
          },
          "properties": {
            "grounding": "measured",
            "source": "evidence/bench/2026-08-30-ollama/comparator.log",
            "failure_scenario": "A reader reproduces the published ratio and measures parity, because the harness never executed the comparator.",
            "precision_class": "advisory"
          }
        }
      ]
    }
  ]
}
