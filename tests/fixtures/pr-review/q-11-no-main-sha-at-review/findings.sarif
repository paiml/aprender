{
  "$schema": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/errata01/os/schemas/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "pmat"
        }
      },
      "invocations": [
        {
          "executionSuccessful": true,
          "toolExecutionNotifications": []
        }
      ],
      "results": [
        {
          "ruleId": "complexity_delta",
          "level": "note",
          "message": {
            "text": "The launch wrapper is unchanged in cyclomatic complexity."
          },
          "properties": {
            "grounding": "measured",
            "source": "pmat analyze complexity --format json",
            "failure_scenario": "None: the measurement shows no delta, and a no-delta measurement is still a measurement.",
            "precision_class": "advisory"
          }
        }
      ]
    }
  ]
}
